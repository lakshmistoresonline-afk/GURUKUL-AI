        "source_evidence": [
          "1 \u092e\u093e\u0924\u0943\u092d\u0942\u092e\u093f \u090a\u0901\u091a\u093e \u0916\u0921\u093c\u093e \u0939\u093f\u092e\u093e\u0932\u092f \u0906\u0915\u093e\u0936 \u091a\u092e\u0942 \u0924\u093e \u0939\u0948, \u0928\u0940\u091a\u0947 \u091a\u0930\u0923 \u0924\u0932\u0947 \u091d\u0915 \u0941 , \u0928\u093f\u0924 \u0938\u093f\u0902\u0927\u0941 \u091d\u092e\u0942 \u0924\u093e \u0939\u0948\u0964",
          "\u0917\u0917\u0902 \u093e \u092f\u092e\u0928\u0941 \u0924\u094d\u0930\u093f\u0935\u0947\u0923\u0940 \u0928\u0926\u093f\u092f\u093e\u0901 \u0932\u0939\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902, \u091c\u0917\u092e\u0917 \u091b\u091f\u093e \u0928\u093f\u0930\u093e\u0932\u0940, \u092a\u0917 \u092a\u0917 \u091b\u0939\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964",
          "\u091d\u0930\u0928\u0947 \u0905\u0928\u0947\u0915 \u091d\u0930\u0924\u0947 \u091c\u093f\u0938\u0915\u0940 \u092a\u0939\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u092e\u0947\u0902, \u091a\u093f\u0921\u093c\u093f\u092f\u093e\u0901 \u091a\u0939\u0915 \u0930\u0939\u0940 \u0939\u0948\u0902, \u0939\u094b \u092e\u0938\u094d\u0924 \u091d\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u092e\u0947\u0902\u0964",
          "\u091c\u0928\u094d\u092e\u0947 \u091c\u0939\u093e\u0901 \u0925\u0947 \u0930\u0918\u092a\u0941 \u0924\u093f, \u091c\u0928\u094d\u092e\u0940 \u091c\u0939\u093e\u0901 \u0925\u0940 \u0938\u0940\u0924\u093e, \u0936\u094d\u0930\u0940\u0915\u0943 \u0937\u094d\u0923 \u0928\u0947 \u0938\u0928\u0941 \u093e\u0908, \u0935\u0936\u0902 \u0940 \u092a\u0928\u0941 \u0940\u0924 \u0917\u0940\u0924\u093e\u0964"
        ]
