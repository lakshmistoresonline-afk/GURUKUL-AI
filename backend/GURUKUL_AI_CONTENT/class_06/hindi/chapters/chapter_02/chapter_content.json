  "content": {
    "overview": "Canonical source-derived learning unit: \u0917\u094b\u0932.",
    "source_grounded_key_points": [
      "2 \u0917\u094b\u0932 \u0907\u0938 \u092a\u093e\u0920 \u0915\u093e \u0928\u093e\u092e \u092a\u0922\u093c\u0915\u0930 \u0906\u092a\u0915\u0947 \u092e\u0928 \u092e\u0947\u0902 \u0915\u0941\u091b \u0917\u094b\u0932 \u0935\u0938\u094d\u0924\u0941\u0913 \u0902 \u0915\u0947 \u0928\u093e\u092e \u092f\u093e \u091a\u093f\u0924\u094d\u0930 \u0909\u092d\u0930\u0947 \u0939\u094b\u0902\u0917\u0947, \u0917\u094b\u0932 \u0917\u0947\u0902\u0926, \u0917\u094b\u0932 \u0930\u094b\u091f\u0940, \u0917\u094b\u0932 \u091a\u0926\u094d\u0930\u0902 \u092e\u093e \u0906\u0926\u093f\u0964",
      "\u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u092a\u093e\u0920 \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u0917\u094b\u0932 \u0914\u0930 \u0909\u0938\u0947 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0939\u0948\u0964",
      "\u0906\u0907\u090f, \u0907\u0938\u0947 \u092a\u0922\u093c\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u094c\u0928 \u0925\u0947 \u0935\u0947 \u092a\u094d\u0930\u0938\u093f\u200d\u0926\u094d\u0927 \u0916\u200d\u093f\u0932\u093e\u0921\u093c\u0940!",
      "\u0916\u0947\u0932 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u092e\u0947\u0902 \u0927\u0915\u094d\u0915\u093e-\u092e\u0915\u0941 \u094d\u0915\u0940 \u0914\u0930 \u0928\u094b\u0902\u0915-\u091d\u094b\u0902\u0915 \u0915\u0940 \u0918\u091f\u0928\u093e\u090f\u0901 \u0939\u094b\u0924\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964",
      "\u0909\u0928 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, \u092e\u0948\u0902 \u092a\u0902\u091c\u093e\u092c \u0930\u0947 \u091c\u093f\u092e\u0947\u0902\u091f \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0916\u0947\u0932\u093e \u0915\u0930\u0924\u093e \u0925\u093e\u0964",
      "\u090f\u0915 \u0926\u093f\u0928 \u2018\u092a\u0902\u091c\u093e\u092c \u0930\u0947 \u091c\u093f\u092e\u0947\u0902\u091f\u2019 \u0914\u0930 \u2018\u0938\u0948\u0902\u092a\u0930\u094d\u0938 \u090f\u0921\u0902 \u092e\u093e\u0907\u0928\u0930\u094d\u0938 \u091f\u0940\u092e\u2019 \u0915\u0947 \u092c\u0940\u091a \u092e\u0915 \u0941 \u093e\u092c\u0932\u093e \u0939\u094b \u0930\u0939\u093e \u0925\u093e\u0964",
      "\u2018\u092e\u093e\u0907\u0928\u0930\u094d\u0938 \u091f\u0940\u092e\u2019 \u0915\u0947 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u092e\u091d\u0941 \u0938\u0947 \u0917\u0947\u0902\u0926 \u091b\u0940\u0928\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u0947, \u0932\u0947\u0915\u093f\u0928 \u0909\u0928\u0915\u0940 \u0939\u0930 \u0915\u094b\u0936\u093f\u0936 \u092c\u0947\u0915\u093e\u0930 \u091c\u093e\u0924\u0940\u0964",
      "\u0907\u0924\u0928\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u0928\u0947 \u0917\u0938\u0941 \u094d\u0938\u0947 \u092e\u0947\u0902 \u0906\u0915\u0930 \u0939\u0949\u0915\u0940 \u0938\u094d\u091f\u093f\u200d\u0915 \u092e\u0947\u0930\u0947 \u0938\u093f\u0930 \u092a\u0930 \u0926\u0947 \u092e\u093e\u0930\u0940\u0964"
    ],
