        "source_evidence": [
          "6 \u092e\u0947\u0930\u0940 \u092e\u093e\u0901 \u201c\u0936\u094d\u0930\u0940 \u0930\u093e\u092e\u092a\u094d\u0930\u0938\u093e\u0926 \u2018\u092c\u093f\u0938\u094d\u092e\u093f\u0932\u2019 \u092c\u0921\u093c\u0947 \u0939\u094b\u0928\u0939\u093e\u0930 \u0928\u094c\u091c\u0935\u093e\u0928 \u0925\u0947\u0964",
          "\u091c\u093e\u0928\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0926\u093f \u0915\u093f\u0938\u0940 \u0914\u0930 \u091c\u0917\u0939 \u092f\u093e \u0915\u093f\u0938\u0940 \u0914\u0930 \u0926\u0947\u0936 \u092f\u093e \u0915\u093f\u0938\u0940 \u0914\u0930 \u0938\u092e\u092f \u092a\u0948\u0926\u093e \u0939\u0941\u090f \u0939\u094b\u0924\u0947 \u0924\u094b \u0938\u0947\u0928\u093e\u0927\u094d\u092f\u0915\u094d\u0937 \u092c\u0928\u0924\u0947\u0964\u201d \u092f\u0939 \u0915\u0939\u0928\u093e \u0939\u0948 \u0939\u092e\u093e\u0930\u0947 \u0926\u0947\u0936 \u0915\u0947 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0938\u0947\u0928\u093e\u0928\u0940 \u092d\u0917\u0924 \u0938\u093f\u0902\u0939 \u0915\u093e \u092c\u093f\u0938\u094d\u092e\u093f\u0932 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902\u0964",
          "\u0930\u093e\u092e\u092a\u094d\u0930\u0938\u093e\u0926 \u2018\u092c\u093f\u0938\u094d\u092e\u093f\u0932\u2019 \u0915\u093e \u091c\u0928\u094d\u092e \u091c\u092c \u0939\u0941\u0906, \u0909\u0938 \u0938\u092e\u092f \u092d\u093e\u0930\u0924 \u092a\u0930 \u0905\u0917\u094d\u0902 \u0930\u0947\u091c\u093c\u094b\u0902 \u0915\u093e \u0906\u0927\u093f\u200d\u092a\u0924\u094d\u092f \u0925\u093e\u0964",
          "\u2018\u092c\u093f\u0938\u094d\u092e\u093f\u0932\u2019 \u091b\u094b\u091f\u0940-\u0938\u0940 \u0906\u092f\u0941 \u0938\u0947 \u0939\u0940 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0917\u094d\u0902 \u0930\u0947\u091c\u093c\u094b\u0902 \u0938\u0947 \u0932\u095c\u0924\u0947 \u0930\u0939\u0947\u0964"
