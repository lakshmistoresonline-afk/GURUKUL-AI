  "content": {
    "overview": "Canonical source-derived learning unit: \u091c\u0932\u093e\u0924\u0947 \u091a\u0932\u094b.",
    "source_grounded_key_points": [
      "7 \u091c\u0932\u093e\u0924\u0947 \u091a\u0932\u094b \u091c\u0932\u093e\u0924\u0947 \u091a\u0932\u094b \u092f\u0947 \u0926\u093f\u200d\u092f\u0947 \u0938\u094d\u0928\u0947\u0939 \u092d\u0930-\u092d\u0930 \u0915\u092d\u0940 \u0924\u094b \u0927\u0930\u093e \u0915\u093e \u0905\u0901\u0927\u0930\u0947 \u093e \u092e\u093f\u091f\u0947\u0917\u093e\u0964",
      "\u092d\u0932\u0947 \u0936\u0915\u094d\u200d\u0924\u200d\u093f \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u092e\u0947\u0902 \u0939\u0948 \u0928\u093f\u0939\u093f\u0924 \u0935\u0939 \u0915\u093f \u091c\u093f\u0938\u0938\u0947 \u0905\u092e\u093e\u0935\u0938 \u092c\u0928\u0947 \u092a\u0930\u0942 \u094d\u0923\u093f\u092e\u093e-\u0938\u0940, \u092e\u0917\u0930 \u0935\u093f\u0936\u094d\u200d\u0935 \u092a\u0930 \u0906\u091c \u0915\u094d\u092f\u094b\u0902 \u0926\u093f\u0935\u0938 \u0939\u0940 \u092e\u0947\u0902 \u0918\u093f\u0930\u0940 \u0906 \u0930\u0939\u0940 \u0939\u0948 \u0905\u092e\u093e\u0935\u0938 \u0928\u093f\u0936\u093e-\u0938\u0940\u0964",
      "\u092c\u093f\u0928\u093e \u0938\u094d\u0928\u0947\u0939 \u0935\u093f\u0926\u094d\u0924\u092f\u0941 -\u0926\u093f\u200d\u092f\u0947 \u091c\u0932 \u0930\u0939\u0947 \u091c\u094b \u092c\u091d\u0941 \u093e\u0913 \u0907\u0928\u094d\u0939\u0947\u0902, \u092f\u094b\u0902 \u0928 \u092a\u0925 \u092e\u093f\u0932 \u0938\u0915\u0947 \u0917\u093e\u0964\u0964",
      "\u091c\u0932\u093e \u0926\u0940\u092a \u092a\u0939\u0932\u093e \u0924\u092e\u0941 \u094d\u0939\u0940\u0902 \u0928\u0947 \u0924\u093f\u092e\u093f\u0930 \u0915\u0940 \u091a\u0941\u0928\u094c\u0924\u0940 \u092a\u094d\u0930\u0925\u092e \u092c\u093e\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0925\u0940, \u0924\u093f\u092e\u093f\u0930 \u0915\u0940 \u0938\u0930\u093f\u0924 \u092a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0924\u092e\u0941 \u094d\u0939\u0940\u0902 \u0928\u0947 \u092c\u0928\u093e \u0926\u0940\u092a \u0915\u0940 \u0928\u093e\u0935 \u0924\u0948\u092f\u093e\u0930 \u0915\u0940 \u0925\u0940\u0964",
      "\u092c\u0939\u093e\u0924\u0947 \u091a\u0932\u094b \u0928\u093e\u0935 \u0924\u0941\u092e \u0935\u0939 \u0928\u093f\u0930\u0902\u0924\u0930 \u0915\u092d\u0940 \u0924\u094b \u0924\u093f\u092e\u093f\u0930 \u0915\u093e \u0915\u093f\u0928\u093e\u0930\u093e \u092e\u093f\u0932\u0947\u0917\u093e\u0964\u0964",
      "\u092f\u0917\u0941 \u094b\u0902 \u0938\u0947 \u0924\u092e\u0941 \u094d\u0939\u0940\u0902 \u0928\u0947 \u0924\u093f\u092e\u093f\u0930 \u0915\u0940 \u0936\u093f\u0932\u093e \u092a\u0930 \u0926\u093f\u092f\u0947 \u0905\u0928\u0917\u093f\u0928\u0924 \u0939\u0948 \u0928\u093f\u0930\u0902\u0924\u0930 \u091c\u0932\u093e\u090f, \u0938\u092e\u092f \u0938\u093e\u0915\u094d\u0937\u0940 \u0939\u0948 \u0915\u093f \u091c\u0932\u0924\u0947 \u0939\u0941\u090f \u0926\u0940\u092a \u0905\u0928\u0917\u093f\u0928 \u0924\u092e\u0941 \u094d\u0939\u093e\u0930\u0947 \u092a\u0935\u0928 \u0928\u0947 \u092c\u091d\u0941 \u093e\u090f\u0964",
      "\u0926\u093f\u200d\u092f\u0947 \u0914\u0930 \u0924\u092b\u0942 \u093c\u093e\u0928 \u0915\u0940 \u092f\u0939 \u0915\u0939\u093e\u0928\u0940 \u091a\u0932\u0940 \u0906 \u0930\u0939\u0940 \u0914\u0930 \u091a\u0932\u0924\u0940 \u0930\u0939\u0947\u0917\u0940, \u091c\u0932\u0940 \u091c\u094b \u092a\u094d\u0930\u0925\u092e \u092c\u093e\u0930 \u0932\u094c \u0926\u0940\u092a \u0915\u0940 \u0938\u094d\u0935\u0930\u094d\u0923-\u0938\u0940 \u091c\u0932 \u0930\u0939\u0940 \u0914\u0930 \u091c\u0932\u0924\u0940 \u0930\u0939\u0947\u0917\u0940\u0964",
      "\u0930\u0939\u0947\u0917\u093e \u0927\u0930\u093e \u092a\u0930 \u0926\u093f\u092f\u093e \u090f\u0915 \u092d\u0940 \u092f\u0926\u093f \u0915\u092d\u0940 \u0924\u094b \u0928\u093f\u0936\u093e \u0915\u094b \u0938\u0935\u0947\u0930\u093e \u092e\u093f\u0932\u0947\u0917\u093e\u0964\u0964"
    ],
