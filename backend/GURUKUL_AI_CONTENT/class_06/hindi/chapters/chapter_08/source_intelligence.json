{
  "chapter_id": "fhml108",
  "class": "class_06",
  "subject": "Hindi",
  "chapter_number": 108,
  "chapter_title": "\u0938\u0924\u094d\u0930\u093f\u092f\u093e \u0914\u0930 \u092c\u093f\u0939\u0942 \u0928\u0943\u0924\u094d\u092f",
  "source_text_file": "SOURCE_TEXT/Hindi_fhml108.txt",
  "source_key_points": [
    "\u0907\u0938\u0915\u0940 \u0930\u0902\u0917-\u092c\u093f\u0930\u0902\u0917\u0940, \u0938\u0902\u0926\u0941 \u0930, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0914\u0930 \u091c\u0940\u0935\u0928 \u0938\u0947 \u092d\u0930\u0940 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u092a\u0930\u0942 \u0940 \u0926\u0928\u093f \u0941 \u092f\u093e \u092e\u0947\u0902 \u0905\u0928\u094b\u0916\u0940 \u0939\u0948\u0964",
    "\u092d\u093e\u0930\u0924 \u0915\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0928\u0943\u0924\u094d\u092f, \u0938\u0902\u0917\u0940\u0924, \u0915\u0932\u093e, \u0916\u093e\u0928-\u092a\u093e\u0928, \u092d\u093e\u0937\u093e, \u092a\u0939\u0928\u093e\u0935\u093e, \u0930\u0939\u0928-\u0938\u0939\u0928 \u0915\u0947 \u0924\u0930\u0940\u0915\u0947 , \u0938\u092c \u0915\u0941\u091b \u0907\u0924\u0928\u093e \u092e\u094b\u0939\u0915 \u0939\u0948 \u0915\u093f \u092a\u0930\u0942 \u0940 \u0926\u0928\u093f \u0941 \u092f\u093e \u0938\u0947 \u0932\u094b\u0917 \u092d\u093e\u0930\u0924 \u0915\u0940 \u0913\u0930 \u0916\u093f\u200d\u0902\u091a\u0947 \u091a\u0932\u0947 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0907\u0938 \u092a\u093e\u0920 \u092e\u0947\u0902 \u092d\u0940 \u090f\u0915 \u092a\u0930\u093f\u0935\u093e\u0930 \u090f\u0915 \u0926\u0938\u0942 \u0930\u0947 \u0926\u0947\u0936 \u0938\u0947 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0906\u092f\u093e \u0939\u0948\u0964",
    "\u0906\u0907\u090f, \u092a\u0922\u093c\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u0947 \u0915\u094c\u0928 \u0939\u0948\u0902, \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0915\u0939\u093e\u0901 \u0906\u090f \u0939\u0948\u0902, \u0914\u0930 \u0915\u094d\u092f\u094b\u0902 \u0906\u090f \u0939\u0948\u0902?",
    "\u090f\u091c\u0902 \u0947\u0932\u093e \u0932\u0902\u0926\u0928 \u0915\u0947 \u091c\u093e\u0928\u0947-\u092e\u093e\u0928\u0947 \u0907\u0932\u093e\u0915\u0947 \u0915\u0947\u0902 \u091c\u093f\u0917\u0902 \u094d\u091f\u0928 \u092e\u0947\u0902 \u0930\u0939\u0924\u0940 \u0925\u0940\u0964",
    "\u0909\u0938\u0947 \u091c\u0947\u092e\u094d\u0938 \u0914\u0930 \u0915\u0940\u0930\u093e \u0928\u093e\u092e \u0915\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u0928\u093e \u092a\u0938\u0902\u0926 \u0925\u093e\u0964",
    "\u0909\u0928\u094d\u0939\u0947\u0902 \u0910\u0938\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u093e\u0924\u094d\u0930 \u092c\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u091c\u093c\u093e \u0906\u0924\u093e \u0925\u093e, \u091c\u093f\u0928\u092e\u0947\u0902 \u0926\u0930\u0942 -\u0926\u0930\u093e\u091c\u093c \u0915\u0940 \u0926\u0928\u093f \u0941 \u092f\u093e \u0915\u093e \u091c\u093f\u0915\u094d\u0930 \u0939\u094b\u0964",
    "\u090f\u091c\u0902 \u0947\u0932\u093e \u0915\u094b \u0939\u0930 \u0909\u0938 \u0915\u0939\u093e\u0928\u0940 \u0938\u0947 \u092a\u094d\u092f\u093e\u0930 \u0925\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u0909\u0938\u0947 \u0924\u093e\u091c\u092e\u0939\u0932, \u090f\u092b\u093f\u0932 \u091f\u0949\u0935\u0930 \u092f\u093e \u0915\u094b\u0932\u094b\u091c\u093f\u092f\u092e \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u091c\u093e\u0928\u093e \u0939\u094b\u0964"
  ]
}