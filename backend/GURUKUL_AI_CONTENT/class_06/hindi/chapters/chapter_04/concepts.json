        "id": "fhml104_c01",
        "name": "\u0939\u093e\u0930 \u0915\u0940 \u091c\u0940\u0924",
        "definition": "Central learning focus of \u0939\u093e\u0930 \u0915\u0940 \u091c\u0940\u0924.",
        "source_evidence": "4 \u0939\u093e\u0930 \u0915\u0940 \u091c\u0940\u0924 \u092e\u093e\u0901 \u0915\u094b \u0905\u092a\u0928\u0947 \u092c\u0947\u091f\u0947 \u0914\u0930 \u0915\u093f\u0938\u093e\u0928 \u0915\u094b \u0905\u092a\u0928\u0947 \u0932\u0939\u0932\u0939\u093e\u0924\u0947 \u0916\u0947\u0924 \u0926\u0947\u0916\u0915\u0930 \u091c\u094b \u0906\u0928\u0902\u0926 \u0906\u0924\u093e \u0939\u0948, \u0935\u0939\u0940 \u0906\u0928\u0902\u0926 \u092c\u093e\u092c\u093e \u092d\u093e\u0930\u0924\u0940 \u0915\u094b \u0905\u092a\u0928\u093e \u0918\u094b\u0921\u093c\u093e \u0926\u0947\u0916\u0915\u0930 \u0906\u0924\u093e \u0925\u093e\u0964"
      },
      {
        "id": "fhml104_c02",
        "name": "Evidence and reasoning",
        "definition": "Support a conclusion with source information or valid working.",
        "source_evidence": "\u092c\u093e\u092c\u093e \u092d\u093e\u0930\u0924\u0940 \u0909\u0938\u0947 \u0938\u0932\u0941 \u0924\u093e\u0928 \u0915\u0939 \u0915\u0930 \u092a\u0915 \u0941 \u093e\u0930\u0924\u0947, \u0905\u092a\u0928\u0947 \u0939\u093e\u0925 \u0938\u0947 \u0916\u0930\u0939\u0930\u093e \u0915\u0930\u0924\u0947, \u0916\u0926\u0941 \u0926\u093e\u0928\u093e \u0916\u093f\u0932\u093e\u0924\u0947 \u0914\u0930 \u0926\u0947\u0916-\u0926\u0947\u0916\u0915\u0930 \u092a\u094d\u0930\u0938\u0928\u094d\u0928 \u0939\u094b\u0924\u0947 \u0925\u0947\u0964"
      },
      {
        "id": "fhml104_c03",
        "name": "Application",
        "definition": "Transfer the learned idea to a relevant new context.",
        "source_evidence": "\u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0930\u0941\u092a\u092f\u093e, \u092e\u093e\u0932, \u0905\u0938\u092c\u093e\u092c, \u091c\u093c\u092e\u0940\u0928 \u0906\u0926\u093f \u0905\u092a\u0928\u093e \u0938\u092c-\u0915\u0941\u091b \u091b\u094b\u095c \u0926\u093f\u092f\u093e \u0925\u093e, \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0928\u0917\u0930 \u0915\u0947 \u091c\u0940\u0935\u0928 \u0938\u0947 \u092d\u0940 \u0918\u0943\u0923\u093e \u0925\u0940\u0964"
      }
