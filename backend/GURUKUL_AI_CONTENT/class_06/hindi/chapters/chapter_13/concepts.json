        "name": "\u092a\u0947\u0921\u093c \u0915\u0940 \u092c\u093e\u0924",
        "definition": "Central learning focus of \u092a\u0947\u0921\u093c \u0915\u0940 \u092c\u093e\u0924.",
        "source_evidence": "\u0915\u0948 \u0938\u0947 \u0905\u0915 \u0902 \u0941 \u0930 \u092b\u0942\u091f\u0924\u093e \u0939\u0948, \u092a\u094c\u0927\u093e \u092c\u0928\u0924\u093e \u0939\u0948, \u0927\u0940\u0930\u0947 -\u0927\u0940\u0930\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948 \u0914\u0930 \u092c\u0921\u093c\u093e \u092a\u0947\u0921\u093c \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
      },
      {
        "id": "fhml113_c02",
        "name": "Evidence and reasoning",
        "definition": "Support a conclusion with source information or valid working.",
        "source_evidence": "\u092e\u093e\u0928\u094b\u0902 \u092c\u093e\u0939\u0930 \u0938\u0947 \u0915\u094b\u0908 \u0936\u093f\u0936\u0941 \u0915\u094b \u092a\u0915 \u0941 \u093e\u0930 \u0930\u0939\u093e \u0939\u094b, \u2018\u0914\u0930 \u0938\u094b\u090f \u092e\u0924 \u0930\u0939\u094b, \u090a\u092a\u0930 \u0909\u0920 \u091c\u093e\u0913, \u0938\u0930\u0942 \u091c \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0926\u0947\u0916\u094b\u0964\u2019 \u0906\u0939\u093f\u0938\u094d\u0924\u093e-\u0906\u0939\u093f\u0938\u094d\u0924\u093e \u092c\u0940\u091c \u0915\u093e \u0922\u0915\u094d\u0915\u0928 \u0926\u0930\u0915 \u0917\u092f\u093e, \u0926\u094b \u0938\u0915 \u0941 \u094b\u092e\u0932 \u092a\u0924\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0905\u0915 \u0902 \u0941 \u0930 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u093e\u0964"
      },
      {
        "id": "fhml113_c03",
        "name": "Application",
        "definition": "Transfer the learned idea to a relevant new context.",
        "source_evidence": "\u0905\u0915 \u0902 \u0941\u0930 \u0915\u093e \u090f\u0915 \u0905\u0936 \u0902 \u0928\u0940\u091a\u0947 \u092e\u093e\u091f\u0940 \u092e\u0947\u0902 \u092e\u091c\u093c\u092c\u0924\u0942 \u0940 \u0938\u0947 \u0917\u0921\u093c \u0917\u092f\u093e \u0914\u0930 \u0926\u0938\u0942 \u0930\u093e \u0905\u0936 \u0902 \u092e\u093e\u091f\u0940 \u092d\u0947\u0926\u0915\u0930 \u090a\u092a\u0930 \u0915\u0940 \u0913\u0930 \u0909\u0920\u093e\u0964"
      }
