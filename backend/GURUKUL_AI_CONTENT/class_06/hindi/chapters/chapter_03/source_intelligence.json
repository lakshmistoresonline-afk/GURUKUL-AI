  "chapter_id": "fhml103",
  "class": "class_06",
  "subject": "Hindi",
  "chapter_number": 103,
  "chapter_title": "\u092a\u0939\u0932\u0940 \u092c\u0942\u0901\u0926",
  "source_text_file": "SOURCE_TEXT/Hindi_fhml103.txt",
  "source_key_points": [
    "3 \u092a\u0939\u0932\u0940 \u092c\u0942\u0901\u0926 \u0935\u0939 \u092a\u093e\u0935\u0938 \u0915\u093e \u092a\u094d\u0930\u0925\u092e \u0926\u093f\u0935\u0938 \u091c\u092c, \u092a\u0939\u0932\u0940 \u092c\u0901\u0926\u0942 \u0927\u0930\u093e \u092a\u0930 \u0906\u0908\u0964",
    "\u2014 \u0917\u094b\u092a\u093e\u0932\u0915\u0943 \u0937\u094d\u0923 \u0915\u094c\u0932 \u0915\u0935\u093f \u0938\u0947 \u092a\u0930\u093f\u091a\u092f \u0927\u0930\u0924\u0940 \u0915\u0947 \u0938\u0916 \u0942 \u0947 \u0905\u0927\u0930\u094b\u0902 \u092a\u0930 \u2018\u092a\u0939\u0932\u0940 \u092c\u0901\u0926\u0942 \u2019 \u0915\u0947 \u0917\u093f\u0930\u0928\u0947 \u0915\u093e \u0905\u0926\u092d\u094d \u0924\u0941 \u0926\u0943\u0936\u094d\u092f \u0930\u091a\u0928\u0947 \u0935\u093e\u0932\u0947 \u092c\u093e\u0932 \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u0915\u093e\u0930 \u0917\u094b\u092a\u093e\u0932\u0915\u0943 \u0937\u094d\u0923 \u0915\u094c\u0932 (1923\u20132007) \u0928\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u0947\u0936-\u092a\u094d\u0930\u0947\u092e, \u092a\u094d\u0930\u0915\u0943 \u0924\u093f \u092e\u0932\u094d\u0939\u093e\u0930 \u0914\u0930 \u091c\u0940\u0935-\u091c\u0902\u0924\u0913 \u0941 \u0902 \u0938\u0947 \u091c\u0921\u0941 \u093c\u0940 \u092c\u0939\u0941\u0924-\u0938\u0940 \u092e\u0928\u094b\u0930\u092e \u0915\u0935\u093f\u0924\u093e\u090f\u0901 \u0932\u093f\u0916\u0940 \u0939\u0948\u0902\u0964",
    "\u0905\u092a\u0928\u0940 \u090f\u0915 \u0905\u0928\u094d\u092f 26 \u0915\u0935\u093f\u0924\u093e \u2018\u0939\u092e \u0915\u0941\u091b \u0938\u0940\u0916\u0947\u0902\u2019 \u092e\u0947\u0902 \u0935\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u2014 \u201c\u0926\u0947\u0936 \u0939\u092e\u0947\u0902 \u0926\u0947\u0924\u093e \u0939\u0948 \u0938\u092c \u0915\u0941\u091b, \u0939\u092e \u092d\u0940 \u0924\u094b \u0915\u0941\u091b \u0926\u0947\u0928\u093e \u0938\u0940\u0916\u0947\u0902\u0964\u201d Reprint 2026-27 Chapter 3.indd 26 10/06/2024 11:11:07 \u092a\u093e\u0920 \u0938\u0947 \u092e\u0947\u0930\u0940 \u0938\u092e\u091d \u0938\u0947 (\u0915) \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u0936\u094d\u200d\u0928\u094b\u0902 \u0915\u093e \u0938\u091f\u0940\u0915 \u0909\u0924\u094d\u0924\u0930 \u0915\u094c\u0928-\u0938\u093e \u0939\u0948?",
    "\u0915\u0935\u093f\u0924\u093e \u092e\u0947\u0902 \u2018\u0928\u0935-\u091c\u0940\u0935\u0928 \u0915\u0940 \u0932\u0947 \u0905\u0901\u0917\u0921\u093c\u093e\u0908\u2019 \u0915\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u092f\u0915\u094d\u0941 \u200d\u0924 \u0939\u0941\u0906 \u0939\u0948?",
    "\u2018\u0928\u0940\u0932\u0947 \u0928\u092f\u0928\u094b\u0902-\u0938\u093e \u092f\u0939 \u0905\u092c\u0902 \u0930, \u0915\u093e\u0932\u0940 \u092a\u0924\u0941 \u0932\u0940- \u0938\u0947 \u092f\u0947 \u091c\u0932\u0927\u0930\u2019 \u092e\u0947\u0902 \u2018\u0915\u093e\u0932\u0940 \u092a\u0924\u0941 \u0932\u0940\u2019 \u0939\u0948\u2014 \u0083\u0083 \u092c\u093e\u0930\u093f\u0936 \u0915\u0940 \u092c\u0901\u0942\u0926\u0947\u0902 \u0083\u0083 \u0928\u0917\u093e\u095c\u093e \u0083\u0083 \u0935\u0943\u0926\u094d\u0927 \u0927\u0930\u0924\u0940 \u0083\u0083 \u092c\u093e\u0926\u0932 (\u0916) \u0905\u092c \u0905\u092a\u0928\u0947 \u092e\u093f\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0930\u094d\u091a\u093e \u0915\u0940\u091c\u093f\u090f \u0915\u093f \u0906\u092a\u0928\u0947 \u092f\u0947 \u0909\u0924\u094d\u0924\u0930 \u0915\u094d\u092f\u094b\u0902 \u091a\u0928\u0941 \u0947?",
    "\u092e\u093f\u0932\u0915\u0930 \u0915\u0930\u0947\u0902 \u092e\u093f\u0932\u093e\u0928 \u0915\u0935\u093f\u0924\u093e \u0915\u0940 \u0915\u0941\u091b \u092a\u0915\u094d\u200d\u0924\u093f \u0902 \u092f\u093e\u0901 \u0928\u0940\u091a\u0947 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0902\u0964",
    "\u0905\u092a\u0928\u0947 \u0935\u093f\u091a\u093e\u0930 \u0915\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0938\u092e\u0939\u0942 \u092e\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0940\u091c\u093f\u090f \u0914\u0930 \u0905\u092a\u0928\u0940 \u0932\u0947\u0916\u0928 \u092a\u0938\u094d\u0924\u093f \u0941 \u0915\u093e \u092e\u0947\u0902 \u0932\u093f\u0916\u093f\u090f\u2014 \u0083\u0083 \u201c\u0906\u0938\u092e\u093e\u0928 \u092e\u0947\u0902 \u0909\u0921\u093c\u0924\u093e \u0938\u093e\u0917\u0930, \u0932\u0917\u093e \u092c\u093f\u091c\u0932\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u094d\u0935\u0930\u094d\u0923\u093f\u092e \u092a\u0930, \u092c\u091c\u093e \u0928\u0917\u093e\u095c\u0947 \u091c\u0917\u093e \u0930\u0939\u0947 \u0939\u0948\u0902, \u092c\u093e\u0926\u0932 \u0927\u0930\u0924\u0940 \u0915\u0940 \u0924\u0930\u0941\u0923\u093e\u0908\u0964\u201d \u0083\u0083 \u201c\u0928\u0940\u0932\u0947 \u0928\u092f\u0928\u094b\u0902-\u0938\u093e \u092f\u0939 \u0905\u092c \u0902 \u0930, \u0915\u093e\u0932\u0940 \u092a\u0924\u0941 \u0932\u0940-\u0938\u0947 \u092f\u0947 \u091c\u0932\u0927\u0930\u0964",
    "\u0915\u0930\u0941\u0923\u093e-\u0935\u093f\u0917\u0932\u093f\u0924 \u0905\u0936\u094d\u0930\u0941 \u092c\u0939\u093e\u0915\u0930, \u0927\u0930\u0924\u0940 \u0915\u0940 \u091a\u093f\u0930-\u092a\u094d\u092f\u093e\u0938 \u092c\u091d\u0941 \u093e\u0908\u0964\u201d \u0938\u094b\u091a-\u0935\u093f\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0915\u0935\u093f\u0924\u093e \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u095d\u093f\u090f \u0914\u0930 \u0928\u093f\u092e\u094d\u200d\u0928\u0932\u093f\u0916\u093f\u0924 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092a\u0924\u093e \u0932\u0917\u093e\u0915\u0930 \u0905\u092a\u0928\u0940 \u0932\u0947\u0916\u0928 \u092a\u0938\u094d\u0924\u093f \u0941 \u0915\u093e \u092e\u0947\u0902 \u0932\u093f\u0916\u093f\u090f\u2014 \u0083\u0083 \u092c\u093e\u0930\u093f\u0936 \u0915\u0940 \u092a\u0939\u0932\u0940 \u092c\u0926\u0901\u0942 \u0938\u0947 \u0927\u0930\u0924\u0940 \u0915\u093e \u0939\u0930\u094d\u0937 \u0915\u0948 \u0938\u0947 \u092a\u094d\u0930\u0915\u091f \u0939\u094b\u0924\u093e \u0939\u0948?"
  ]
}