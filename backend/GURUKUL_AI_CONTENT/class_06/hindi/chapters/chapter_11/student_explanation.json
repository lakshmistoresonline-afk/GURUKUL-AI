    ],
    "key_points": [
      "11 \u091a\u0947\u0924\u0915 \u0915\u0940 \u0935\u0940\u0930\u0924\u093e \u0930\u0923-\u092c\u0940\u091a \u091a\u094c\u0915\u0921\u093c\u0940 \u092d\u0930-\u092d\u0930\u0915\u0930 \u091a\u0947\u0924\u0915 \u092c\u0928 \u0917\u092f\u093e \u0928\u093f\u0930\u093e\u0932\u093e \u0925\u093e\u0964",
      "\u2014 \u0936\u094d\u092f\u093e\u092e\u0928\u093e\u0930\u093e\u092f\u0923 \u092a\u093e\u0923\u094d\u0921\u0947\u092f \u0915\u0935\u093f \u0938\u0947 \u092a\u0930\u093f\u091a\u092f \u0935\u0940\u0930 \u0930\u0938 \u0915\u0940 \u0915\u0935\u093f\u0924\u093e\u0913 \u0902 \u0915\u0947 \u0932\u093f\u090f \u091a\u0930\u094d\u091a\u093f\u0924 \u0915\u0935\u093f \u0936\u094d\u092f\u093e\u092e\u0928\u093e\u0930\u093e\u092f\u0923 \u092a\u093e\u0923\u094d\u0921\u0947\u092f \u0915\u0940 \u0938\u0930\u094d\u0935\u093e\u0927\u093f\u0915 \u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f \u0915\u093e\u0935\u094d\u092f\u0915\u0943 \u0924\u093f \u2018\u0939\u0932\u094d\u0926\u0940\u0918\u093e\u091f\u0940\u2019 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u0928 \u0938\u0928 1939 \u092e\u0947\u0902 \u0939\u0941\u0906 \u0925\u093e\u0964",
      "\u0905\u092d\u0940 \u0906\u092a\u0928\u0947 \u091c\u094b \u2018\u091a\u0947\u0924\u0915 \u0915\u0940 \u0935\u0940\u0930\u0924\u093e\u2019 \u0915\u0935\u093f\u0924\u093e \u092a\u0922\u093c\u0940 \u0939\u0948, \u0935\u0939 \u2018\u0939\u0932\u094d\u0926\u0940\u0918\u093e\u091f\u0940\u2019 \u0915\u093e \u0939\u0940 \u090f\u0915 \u0905\u0936 \u0902 (1907\u20131991) \u0939\u0948\u0964",
      "\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0938\u0902\u0917\u094d\u0930\u093e\u092e \u0915\u0947 \u0905\u0924\u200d\u093f \u0902 \u092e \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u2018\u0939\u0932\u094d\u0926\u0940\u0918\u093e\u091f\u0940\u2019 \u0915\u093e\u0935\u094d\u092f\u0915\u0943 \u0924\u093f \u0928\u0947 \u0938\u094d\u200d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0938\u0947\u0928\u093e\u0928\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u090f\u0915\u0924\u093e \u0914\u0930 \u0909\u0924\u094d\u0938\u093e\u0939 \u0915\u093e \u0938\u0902\u091a\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e\u0964",
