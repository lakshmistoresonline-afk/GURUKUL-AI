        "definition": "Central learning focus developed by the chapter '\u091a\u093e\u0901\u0926 \u0915\u093e \u0915\u0941\u0930\u0924\u093e'.",
        "evidence": "\u091a\u093e\u0901\u0926 \u0915\u093e \u0915 \u0941 \u0930\u0924\u093e3 \u0939\u0920 \u0915\u0930 \u092c\u0948\u0920\u093e \u091a\u093e\u0901\u0926 \u090f\u0915 \u0926\u0926\u0928, \u092e\u093e\u0924\u093e \u0938\u0947 \u092f\u0939 \u092c\u094b\u0932\u093e, \u201c\u0926\u0938\u0932\u0935\u093e \u0926\u094b \u092e\u093e\u0901, \u092e\u0941\u091d\u0947 \u090a\u0928 \u0915\u093e \u092e\u094b\u091f\u093e \u090f\u0915 \u0926\u091d\u0902\u0917\u094b\u0932\u093e\u0964"
      },
      {
        "id": "ehve103_concept_02",
        "name": "Evidence and reasoning",
        "definition": "Using chapter information to support an explanation or answer.",
        "evidence": "\u0938\u0928-\u0938\u0928 \u091a\u0932\u0924\u0940 \u0939\u0935\u093e \u0930\u093e\u0924 \u092d\u0930, \u091c\u093e\u0921\u0947 \u0938\u0947 \u092e\u0930\u0924\u093e \u0939\u0942\u0901, \u0926\u0920 \u0920\u0941\u0930-\u0926\u0920\u0920\u0941\u0930\u0915\u0930 \u0926\u0915\u0938\u0940 \u0924\u0930\u0939 \u092f\u093e\u0924\u094d\u093e \u092a\u0942\u0930\u0940 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964"
      },
      {
        "id": "ehve103_concept_03",
        "name": "Application",
        "definition": "Using the chapter idea in a new but related situation.",
        "evidence": "\u0906\u0938\u092e\u093e\u0928 \u0915\u093e \u0938\u092b\u0930 \u0914\u0930 \u092f\u0939 \u092e\u094c\u0938\u092e \u0939\u0948 \u091c\u093e\u0921\u0947 \u0915\u093e, \u0928 \u0939\u094b \u0905\u0917\u0930 \u0924\u094b \u0932\u093e \u0926\u094b \u0915\u0941 \u0930\u0924\u093e \u0939\u0940 \u0915\u094b\u0908 \u092d\u093e\u0921\u0947 \u0915\u093e\u0964\u201d \u092c\u091a\u091a\u0947 \u0915\u0940 \u0938\u0941\u0928 \u092c\u093e\u0924 \u0915\u0939\u093e \u092e\u093e\u0924\u093e \u0928\u0947, \u201c\u0905\u0930\u0947 \u0938\u0932\u094b\u0928\u0947!"
      }
