    "key_points": [
      "\u0917\u0902\u0917\u093e \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092e\u0947\u0930\u093e \u091c\u0928\u092e \u0939\u093f\u092e\u093e\u0932\u092f \u0915\u0940 \u0917\u094b\u0926 \u092e\u0947\u0902 \u093f\u0941\u0906 \u0925\u093e\u0964",
      "\u0928\u0928\u093f\u0939\u0940-\u0938\u0939\u0940 \u0927\u093e\u0930\u093e \u0915 \u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u0948\u0902 \u0909\ufffd\u0930\u093e\u0916\u0902\u0921 \u0915 \u0947 \u0909\ufffd\u0930\u0915\u093e\u0936\u0939\u0940 \u091c\u0928\u092a\u0926 \u092e\u0947\u0902 \u0939\u094d\u200d\u0925\u0924 \u0917\u0902\u0917\u094b\u0924\u094d\u0939\u0940 \u0939\u093f\u092e\u0928\u0926 \u0915 \u0947 \u0909\u0938 \u094d\u200d\u0925\u093e\u0928 \u0938\u0947 \u0939\u0928\u0915\u0932\u0939\u0940 \u0939\u091c\u0938\u0947 \u0917\u094b\u092e\u0941\u0916 \u0915\u093f\u0924\u0947 \u093f\u0948\u0902\u0964",
      "\u0917\u094b\u092e\u0941\u0916 \u0938\u0947 \u0925\u094b\u0921\u093e \u0928\u0939\u0940\u091a\u0947 \u0917\u0902 \u0917\u094b\u0924\u094d \u0939\u0940 \u092e\u0947\u0902 \u092e\u0947\u0930\u093e \u092d\u0935\u094d\u092f \u092e \u0902\u0939\u0926\u0930 \u093f\u0948 \u091c \u093f\u093e\u0901 \u0926\u0947\u0936\u092d\u0930 \u0938\u0947 \u0924 \u0939\u0940\u0925\u094d\u0925\u092f\u093e\u0924\u094d\u0939\u0940 12 \u0906\u0924\u0947 \u093f\u0948\u0902\u0964",
      "\u0930\u093e\u091c\u093e \u092d\u0917\u0939\u0940\u0930\u0925 \u0928\u0947 \u0907\u0938\u0939\u0940 \u094d\u200d\u0925\u093e\u0928 \u092a\u0930 \u0924\u092a \u094d\u200d\u092f\u093e \u0915\u0940 \u0925 \u0939\u0940\u0964",
      "\u092f\u093f\u093e\u0901 \u0938\u0947 \u092e\u0948\u0902 \u0928\u0939\u0940\u091a\u0947 \u0922\u0941\u0932\u0915\u0924\u0939\u0940 \u091a\u0932 \u0939\u0940 \u0914\u0930 \u092e\u0947\u0930\u093e \u0930\u0942\u092a \u0914\u0930 \u0939\u0928\u0916\u0930\u0928\u0947 \u0932\u0917\u093e\u0964"
    ]
