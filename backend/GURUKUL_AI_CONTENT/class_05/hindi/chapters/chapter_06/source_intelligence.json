  "chapter_number": 106,
  "chapter_title": "\u091a\u0924\u0941\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930",
  "pdf_pages": 14,
  "source_file": "HINDI/ehve106.pdf",
  "source_key_points": [
    "\u091a\u0924\u0941\u0930 \u091a\u091a\u0924\u094d\u0930\u0915\u093e\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0938\u0941\u0928\u0938\u093e\u0928 \u091c\u0917\u0939 \u092e\u0947\u0902, \u092c\u0928\u093e \u0930\u0939\u093e \u0925\u093e \u091a\u093f\u0924\u094d\u0930, \u0907\u0924\u0928\u0947 \u0939\u0940 \u092e\u0947\u0902 \u0935\u0939\u093e\u0901 \u0906 \u0917\u092f\u093e, \u092f\u092e \u0930\u093e\u091c\u093e \u0915\u093e \u091a\u092e\u0924\u094d\u0930\u0964",
    "\u0909\u0938\u0947 \u0926\u0947\u0916\u0915\u0930 \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0915 \u0947 , \u0924\u0941\u0930\u0902\u0924 \u0909\u0921\u093c \u0917\u090f \u0939\u094b\u0936, \u0928\u0926\u0940, \u092a\u0939\u093e\u0921\u093c, \u092a\u0947\u0921\u093c, \u092a\u0924\u094d\u0924\u094b\u0902 \u0915\u093e, \u0930\u0939 \u0928 \u0917\u092f\u093e \u0915\u0941 \u091b \u091c\u094b\u0936\u0964",
    "\u091a\u093f\u0930 \u0909\u0938\u0915\u094b \u0915\u0941 \u091b \u091a\u0939\u092e\u092e\u0924 \u0906\u0908, \u0926\u0947\u0916 \u0909\u0938\u0947 \u093f\u0941\u092a\u093f\u093e\u092a, \u092c\u094b\u0932\u093e \u2014 \u0938\u0941\u0902\u0926\u0930 \u091a\u093f\u0924\u094d\u0930 \u092c\u0928\u093e \u0926\u0942\u0901, \u092c\u0948\u0920 \u091c\u093e\u0907\u090f \u0906\u092a\u0964",
    "\u0909\u0915\u0921\u093c\u0942 -\u092e\u0941\u0915\u0921\u093c\u0942 \u092c\u0948\u0920 \u0917\u092f\u093e \u0935\u0939, \u0938\u093e\u0930\u0947 \u0905\u0902\u0917 \u092c\u091f\u094b\u0930, \u092c\u0921\u093c\u0947 \u0927\u092f\u093e\u0928 \u0938\u0947 \u0932\u0917\u093e \u0926\u0947\u0916\u0928\u0947, \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0913\u0930\u0964",
    "\u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0928\u0947 \u0915\u0939\u093e \u2014 \u0939\u094b \u0917\u092f\u093e, \u0906\u0917\u0947 \u0915\u093e \u0924\u0948\u092f\u093e\u0930 , \u0905\u092c \u092e\u0941\u0901\u0939 \u0906\u092a \u0909\u0927\u0930 \u0924\u094b \u0915\u0930\u0930\u090f, \u091c\u0902\u0917\u0932 \u0915 \u0947 \u0938\u0930\u0926\u093e\u0930\u0964",
    "6 Chapter 6.indd 61 11-06-2025 16:49:43 62 \u0935\u0940\u0923\u093e \u0915\ufffd\u093e 5 \u092c\u0948\u0920 \u0917\u092f\u093e \u092a\u0940\u0920 \u091a\u093f\u0930\u093e\u0915\u0930, \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0913\u0930, \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u093f\u0941\u092a\u0915 \u0947 \u0938\u0947 \u091a\u0916\u0938\u0915\u093e, \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u093f\u094b\u0930\u0964",
    "\u092c\u0939\u0941\u0924 \u0926\u0947\u0930 \u0924\u0915 \u0906\u0901\u0916 \u092e\u0942\u0901\u0926\u0915\u0930, \u092a\u0940\u0920 \u0918\u0941\u092e\u093e\u0915\u0930 \u0936\u0947\u0930, \u092c\u0948\u0920\u0947-\u092c\u0948\u0920\u0947 \u0932\u0917\u093e \u0938\u094b\u093f\u0928\u0947, \u0907\u0927\u0930 \u0939\u0941\u0908 \u0915\u092f\u0924\u094b\u0902 \u0926\u0947\u0930 ?",
    "\u091d\u0940\u0932 \u091a\u0915\u0928\u093e\u0930\u0947 \u0928\u093e\u0935 \u0925\u0940, \u090f\u0915 \u0930\u0916\u093e \u0925\u093e \u092c\u093e\u0901\u0938, \u091a\u093f\u0924\u094d\u0930\u0915\u093e\u0930 \u0928\u0947 \u0928\u093e\u0935 \u092a\u0915\u0921\u093c\u0915\u0930, \u0932\u0940 \u091c\u0940 \u092d\u0930 \u0915 \u0947 \u0938\u093e\u0901\u0938\u0964"
  ],
  "source_text_character_count": 12955
}