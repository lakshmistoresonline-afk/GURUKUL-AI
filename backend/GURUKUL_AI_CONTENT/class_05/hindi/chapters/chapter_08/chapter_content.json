  "chapter_title": "\u0915\u093e\u091c\u0940\u0930\u0902\u0917\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0909\u0926\u094d\u092f\u093e\u0928 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e",
