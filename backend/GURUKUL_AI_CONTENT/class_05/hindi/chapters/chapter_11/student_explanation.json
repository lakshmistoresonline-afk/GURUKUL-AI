    ],
    "key_points": [
      "\u0939\u092e\u093e\u0930\u0947 \u092f\u0947 \u0915\u0932\u093e\u092e\u0902\u0926\u093f\u093011 \u0907\u0938 \u092c\u093e\u0930 \u0928\u093f\u0936\u093e \u0915\u0940 \u092e\u094c\u0938\u0940 \u093f\u0947 \u091b\u0941 \u0928 \u091f\u094d \u091f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0909\u0938\u0947 \u0905\u091c\u0902\u0924\u093e \u0914\u0930 \u090f\u0932\u094b\u0930\u093e \u0928\u093f\u0916\u093e\u093f\u0947 \u0915\u093e \u0935\u093e\u093f\u093e \u0928\u0915\u092f\u093e \u0925\u093e\u0964",
      "\u0928\u093f\u0936\u093e \u093f\u0947 \u092a\u0941\u0938\u0924\u0915\u094b\u0902 \u092e\u0947\u0902 \u0905\u091c\u0902 \u0924\u093e, \u090f\u0932\u094b\u0930\u093e \u0915 \u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092a\u095d\u093e \u0925\u093e\u0964",
      "\u0924\u092d\u0940 \u0938\u0947 \u0909\u0938\u0915 \u0947 \u092e \u093f \u092e\u0947\u0902 \u0909\u0924\u0938\u0941\u0915\u0924\u093e \u0925\u0940 \u0928\u0915 \u092f\u0947 \u0917\u0941\u092b\u093e\u090f\u0901 \u093f\u0947\u0916\u093f\u0947 \u092e\u0947\u0902 \u0915 \u0948 \u0938\u0940 \u0939\u094b\u0902\u0917\u0940\u0964",
      "\u093f \u0936\u0939\u0930\u0947 \u0915\u0940 \u091b\u0941 \u0928 \u091f\u094d\u094d\u091f\u092f\u093e\u0901 \u0906\u0907\ufffd \u0924\u094b \u0909\u093f\u0915\u093e \u0905\u091c\u0902 \u0924\u093e \u0914\u0930 \u090f\u0932\u094b\u0930\u093e \u091c\u093e\u093f\u0947 \u0915\u093e \u0915\u093e \u092f\u094d\u092f\u0915\u094d\u0930\u092e \u092c\u093f \u0917\u092f\u093e\u0964",
      "\u0930\u0947\u0932\u0917\u093e\u095c\u0940 \u092e\u0947\u0902 \u0906\u0930\u0915\u094d\u0937\u0923 \u091b\u0924\u094d\u0930\u092a\u0928\u0924 \u0938\u0902 \u092d\u093e\u091c\u0940 \u093f\u0917\u0930 \u0924\u0915 \u0925\u093e\u0964"
    ]
