  "chapter_number": 107,
  "chapter_title": "\u092e\u0947\u0930\u093e \u092c\u091a\u092a\u0928",
  "pdf_pages": 10,
  "source_file": "HINDI/ehve107.pdf",
  "source_key_points": [
    "\u0935\u0939 \u0915\u091a\u091a\u093e \u091f\u0942\u091f\u093e \u0918\u0930, \u0935\u0939 \u092a\u092f\u093e\u0932 \u0915\u093e \u092c\u092c\u091b\u094c\u0928\u093e, \u0935\u0939 \u0928\u0902\u0917\u0947 \u092c\u0926\u0928, \u0928\u0902\u0917\u0947 \u092a\u093e\u0901\u0935 \u0916\u0947\u0924\u094b\u0902 \u092e\u0947\u0902 \u0918\u0942\u092e\u0928\u093e, \u0906\u092e \u0915 \u0947 \u092a\u0947\u0921\u093c\u094b\u0902 \u092a\u0930 \u091a\u0922\u093c\u0928\u093e, \u0938\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0906\u0901\u0916\u094b\u0902 \u0915 \u0947 \u0938\u093e\u092e\u0928\u0947 \u092c\u093f\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964",
    "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u091a\u091a\u0947\u0930\u0947 \u092d\u093e\u0908 \u0939\u0932\u0927\u0930 \u0915 \u0947 \u0938\u093e\u0925 \u0926\u0942\u0938\u0930\u0947 \u0917\u093e \u0901\u0935 \u092e\u0947\u0902 \u090f\u0915 \u092e\u094c\u0932\u0935\u0940 \u0938\u093e\u0939\u092c \u0915 \u0947 \u092f\u0939\u093e\u0901 \u092a\u0922\u093c\u0928\u0947 \u091c\u093e\u092f\u093e \u0915\u0930\u0924\u093e \u0925\u093e\u0964",
    "\u092e\u0947\u0930\u0940 \u0909\u092e\u094d\u0930 \u0906\u0920 \u0938\u093e\u0932 \u0925\u0940, \u0939\u0932\u0927\u0930 \u092e \u0941\u091d\u0938\u0947 \u0926\u094b \u0938\u093e\u0932 \u091c\u0947\u0920\u0947 \u0925\u0947\u0964",
    "\u0939\u092e \u0926\u094b\u0928\u094b\u0902 \u092a\u094d\u093e\u0924\u0903\u0915\u093e\u0932 \u092e\u091f\u0930 \u0914\u0930 \u091c\u094c \u0915\u093e \u091a\u092c\u0947\u0928\u093e \u0932\u0947\u0924\u0947 \u0925\u0947\u0964",
    "\u092e\u0947\u0930\u0947 \u0918\u0930 \u0938\u0947 \u092c\u0939\u0941\u0924 \u0925\u094b\u0921\u093c\u0940 \u0926\u0942\u0930 \u092a\u0930 \u0930\u093e\u092e\u0932\u0940\u0932\u093e \u092e\u0948\u0926\u093e\u0928 \u0925\u093e\u0964",
    "\u092c\u091c\u0938 \u0918\u0930 \u092e\u0947\u0902 \u0932\u0940\u0932\u093e \u092a\u093e\u0924\u094d\u094b\u0902 \u0915\u093e \u0930\u0942\u092a-\u0930\u0902\u0917 \u092d\u0930\u093e \u091c\u093e\u0924\u093e \u0925\u093e, \u0935\u0939 \u0924\u094b \u092e\u0947\u0930\u0947 \u0918\u0930 \u0938\u0947 \u092c\u092c\u0932\u0915\u0941 \u0932 \u092c\u092e\u0932\u093e \u0939\u0941\u0906 Chapter 7.indd 75 11-06-2025 16:51:35 76 \u0935\u0940\u0923\u093e \u0915\ufffd\u093e 5 \u0925\u093e\u0964",
    "\u0926\u094b \u092c\u091c\u0947 \u092c\u0926\u0928 \u0938\u0947 \u092a\u093e\u0924\u094d\u094b\u0902 \u0915\u0940 \u0938\u091c\u093e\u0935\u091f \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0932\u0917\u0924\u0940\u0964",
    "\u092c\u091c\u0938 \u0909\u0924\u0938\u093e\u0939 \u0938\u0947 \u0926\u094c\u0921\u093c\u0915\u0930 \u091b\u094b\u091f\u0947-\u092e\u094b\u091f\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e, \u0909\u0938 \u0909\u0924\u0938\u093e\u0939 \u0938\u0947 \u0924\u094b \u0906\u091c \u0905\u092a\u0928\u0940 \u092a\u0947\u0902\u0936\u0928 \u0932\u0947\u0928\u0947 \u092d\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e\u0964"
  ],
