  "source_file": "HINDI/ehve104.pdf",
  "source_key_points": [
    "33 \u0938\u093e\u0919\u0915\u0947\u0928 \u0938\u093e\u0919\u0915 \u0947 \u09284 \u0905\u0930\u0941\u0923\u093e\u091a\u0932 \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u0947\u0902 \u091a\u094c\u0916\u093e\u092e \u0915 \u0947 \u092e\u0902\u0921\u0932 \u0915\u093e\u0930\u093e\u092f\u093e\u0932\u0930 \u092e\u0947\u0902 \u0935\u0932\u0932\u0930\u0940 \u0915 \u0947 \u092a\u093f\u0924\u093e\u091c\u0940 \u090f\u0915 \u0905\u092a\u093f\u0915\u093e\u0930\u0940 \u0939\u0948\u0902\u0964",
    "\u0907\u0938 \u092c\u093e\u0930 \u0909\u0928 \u0939\u094b\u0902\u0928\u0947 \u092a\u0926\u0932\u0932\u0940 \u0938\u0947 \u0905\u093f\u0928\u0947 \u093f\u0930\u0930\u0935\u093e\u0930 \u0915\u094b \u092d\u0940 \u0905 \u093f\u0928\u0947 \u093f\u093e\u0938 \u092c\u0941\u0932\u093e \u092a\u0932\u0930\u093e \u0939\u0948\u0964",
    "\u0915\u0939\u093e\u0901 \u092a\u0926\u0932\u0932\u0940 \u0915\u0940 \u092d\u0940\u0921\u093c\u092d\u0930\u0940 \u0938\u0921\u093c\u0915 \u0947\u0902 , \u0939\u0949\u0928\u092f\u093e \u092c\u091c\u093e\u0924\u0940 \u0939 \u0941\u0908 \u0915\u093e\u0930 \u0947\u0902 \u0914\u0930 \u092c\u0938\u0947\u0902, \u0906\u0926 \u092a\u092e\u0930\u094b\u0902 \u0915\u0940 \u0932\u0902\u092c\u0940-\u0932\u0902\u092c\u0940 \u0915\u0924\u093e\u0930\u0947\u0902 \u0914\u0930 \u0915\u0939\u093e\u0901 \u091a\u094c\u0916\u093e\u092e \u0915\u093e \u0916\u0941\u0932\u093e \u0914\u0930 \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u0964",
    "\u092a\u091c\u093f\u0930 \u0926\u0947\u0916\u094b, \u0939\u0930\u0930\u0930\u093e\u0932\u0940 \u0939\u0940 \u0939\u0930\u0930\u0930\u093e\u0932\u0940 \u0914\u0930 \u092b\u0942 \u0932 \u0939\u0940 \u092b\u0942 \u0932\u0964",
    "\u0930\u0939\u093e\u0901 \u0915 \u0947 \u0932\u094b\u0917\u094b\u0902 \u0915 \u0947 \u092e\u0941\u0916\u094b\u0902 \u093f\u0930 \u0938\u0926\u0948\u0935 \u092e\u0941\u0938\u0915\u093e\u0928 \u092c\u0928\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964",
    "\u090f\u0915 \u092a\u0926\u0928 \u0935\u0932\u0932\u0930\u0940 \u0915\u094b \u0909\u0938\u0915 \u0947 \u092a\u092e\u0924\u094d\u0930 \u091a\u093e\u090a\u0924\u093e\u0928 \u0928 \u0947 \u0905\u093f\u0928\u0947 \u0918\u0930 \u092c\u0941\u0932\u093e\u0930\u093e\u0964",
    "\u0935\u0932 \u0932\u0930\u0940 \u0905 \u093f\u0928\u0947 \u092a\u093f\u0924\u093e\u091c\u0940 \u0915 \u0947 \u0938\u093e\u0925 \u091a\u093e\u090a\u0924\u093e\u0928 \u0915 \u0947 \u0918\u0930 \u0917\u0908\u0964",
    "\u0909\u0938 \u0938\u092e \u0930 \u091a\u093e\u090a\u0924\u093e\u0928 \u0915 \u0947 \u092a\u093f\u0924\u093e\u091c\u0940 \u0918\u0930 \u0915\u0940 \u0938\u092b\u093e\u0908 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964"
  ],
