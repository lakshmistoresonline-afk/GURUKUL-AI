      },
      {
        "id": "ehve109_fc03",
        "front": "What is a key idea from '\u0928\u094d\u092f\u093e\u092f'?",
        "back": "\u0909\u0926\u094d\u093e\u0928 \u092e\u0947\u0902 \u0907\u0938 \u0938\u092e\u094d\u092f \u0915\u0932\u092a\u0932\u0935\u0938\u0924\u0941 \u0915 \u0947 \u0930\u093e\u091c\u0915\u0941 \u092e\u093e\u0930 \u0932\u0938\u0926\u094d\u093e\u0930\u094d\u0925 \u092a\u094d\u0930\u0938\u0928\u0928 \u092e\u0928 \u090f\u0915 \u0935\u0947\u0926\u0940 \u092a\u0930 \u092c\u0948\u0920\u0947 \u0939\u0948\u0902\u0964",
        "concept_id": "ehve109_concept_01"
      },
      {
        "id": "ehve109_fc04",
        "front": "What is a key idea from '\u0928\u094d\u092f\u093e\u092f'?",
        "back": "\u0926\u094b\u0928\u094b\u0902 \u092c\u093e\u0924\u0947\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964) \u092a\u093e\u0924\u094d\u0930 \u092a\u0930\u093f\u091a\u092f \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 - \u0915\u0938\u093f\u0932\u0935\u0938\u094d\u0924\u0941 \u0915\u0947 \u0930\u0927\u093e\u091c\u0915\u0924\u0941\u092e\u0927\u093e\u0930 \u0926\u0947\u0935\u0926\u0924\u094d\u0924 - \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 \u0915\u0927\u093e \u091a\u091a\u0947\u0930\u0927\u093e \u092d\u0927\u093e\u0908 \u0936\u0924\u0941\u0926\u094d\u0927\u094b\u0926\u0928 - \u0915\u0938\u093f\u0932\u0935\u0938\u094d\u0924\u0941 \u0915\u0947 \u092e\u0939\u0927\u093e\u0930\u0927\u093e\u091c\u0927\u093e \u092e\u0902\u0924\u094d\u0930\u0940 - \u092e\u0939\u0927\u093e\u0930\u0927\u093e\u091c\u0927\u093e \u0915\u0927\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u093f\u0916\u0927\u093e - \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 \u0915\u0927\u093e \u0938\u092e\u0924\u094d \u092a\u094d\u0930\u0938\u094d\u0939\u0927\u093e\u0930\u0930\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 - \u0926\u0947\u0916\u0927\u094b \u0938\u092e\u0924\u094d!",
        "concept_id": "ehve109_concept_01"
      },
      {
        "id": "ehve109_fc05",
        "front": "What is a key idea from '\u0928\u094d\u092f\u093e\u092f'?",
        "back": "\u0935\u0947 \u0905\u093f\u0928\u0947 \u092c\u091a\u091a\u094b\u0902 \u093f\u0947 \u0938\u092e\u0932\u0928\u0947 \u0915\u0927\u094b \u0935\u092f\u0927\u093e\u0915\u0924\u0941\u0932 \u0939\u0948\u0902 \u0914\u0930 \u0917\u0927\u093e\u092f\u0947\u0902 \u0905\u093f\u0928\u0947 \u092c\u091b\u0921\u093c\u094b\u0902 \u0915\u0927\u094b \u092a\u092f\u0927\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u0932\u090f \u0909\u094d\u0927\u093e\u0935\u0932\u0930\u0940 \u0939\u0927\u094b \u0930\u0939\u0930\u0940 \u0939\u0948\u0902\u0964",
