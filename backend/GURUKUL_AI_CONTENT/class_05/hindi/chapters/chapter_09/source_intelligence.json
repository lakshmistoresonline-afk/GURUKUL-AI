  "chapter_title": "\u0928\u094d\u092f\u093e\u092f",
  "pdf_pages": 18,
  "source_file": "HINDI/ehve109.pdf",
  "source_key_points": [
    "\u0928\u094d\u092f\u093e\u094d9 \u092a\u0939\u0932\u093e \u0926 \u0943\u0936\u094d\u092f (\u0930\u0902\u0917\u092e\u0902\u091a \u092a\u0930 \u0930\u093e\u091c-\u0909\u0926\u094d\u093e\u0928 \u0915\u093e \u090f\u0915 \u0926\u0943\u0936\u094d\u092f\u0964",
    "\u0926\u0942\u0930 \u0928\u0947\u092a\u0925\u094d\u092f \u092e \u0947\u0902 \u0935\u0928 \u0938\u0947 \u0932\u094c\u091f\u0924\u0940 \u0917\u093e\u094d\u092f\u094b\u0902 \u0915\u093e \u0938\u0935\u0930 \u0909\u0920\u0924\u093e \u0939\u0941\u0906\u0964",
    "\u0909\u0926\u094d\u093e\u0928 \u092e\u0947\u0902 \u0907\u0938 \u0938\u092e\u094d\u092f \u0915\u0932\u092a\u0932\u0935\u0938\u0924\u0941 \u0915 \u0947 \u0930\u093e\u091c\u0915\u0941 \u092e\u093e\u0930 \u0932\u0938\u0926\u094d\u093e\u0930\u094d\u0925 \u092a\u094d\u0930\u0938\u0928\u0928 \u092e\u0928 \u090f\u0915 \u0935\u0947\u0926\u0940 \u092a\u0930 \u092c\u0948\u0920\u0947 \u0939\u0948\u0902\u0964",
    "\u0926\u094b\u0928\u094b\u0902 \u092c\u093e\u0924\u0947\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964) \u092a\u093e\u0924\u094d\u0930 \u092a\u0930\u093f\u091a\u092f \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 - \u0915\u0938\u093f\u0932\u0935\u0938\u094d\u0924\u0941 \u0915\u0947 \u0930\u0927\u093e\u091c\u0915\u0924\u0941\u092e\u0927\u093e\u0930 \u0926\u0947\u0935\u0926\u0924\u094d\u0924 - \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 \u0915\u0927\u093e \u091a\u091a\u0947\u0930\u0927\u093e \u092d\u0927\u093e\u0908 \u0936\u0924\u0941\u0926\u094d\u0927\u094b\u0926\u0928 - \u0915\u0938\u093f\u0932\u0935\u0938\u094d\u0924\u0941 \u0915\u0947 \u092e\u0939\u0927\u093e\u0930\u0927\u093e\u091c\u0927\u093e \u092e\u0902\u0924\u094d\u0930\u0940 - \u092e\u0939\u0927\u093e\u0930\u0927\u093e\u091c\u0927\u093e \u0915\u0927\u093e \u092e\u0902\u0924\u094d\u0930\u0940 \u093f\u0916\u0927\u093e - \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 \u0915\u0927\u093e \u0938\u092e\u0924\u094d \u092a\u094d\u0930\u0938\u094d\u0939\u0927\u093e\u0930\u0930\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0930\u094d\u0925 - \u0926\u0947\u0916\u0927\u094b \u0938\u092e\u0924\u094d!",
    "\u0935\u0947 \u0905\u093f\u0928\u0947 \u092c\u091a\u091a\u094b\u0902 \u093f\u0947 \u0938\u092e\u0932\u0928\u0947 \u0915\u0927\u094b \u0935\u092f\u0927\u093e\u0915\u0924\u0941\u0932 \u0939\u0948\u0902 \u0914\u0930 \u0917\u0927\u093e\u092f\u0947\u0902 \u0905\u093f\u0928\u0947 \u092c\u091b\u0921\u093c\u094b\u0902 \u0915\u0927\u094b \u092a\u092f\u0927\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u0932\u090f \u0909\u094d\u0927\u093e\u0935\u0932\u0930\u0940 \u0939\u0927\u094b \u0930\u0939\u0930\u0940 \u0939\u0948\u0902\u0964",
    "( \u0917\u093e\u094d\u092f\u094b\u0902 \u0915 \u0947 \u092c\u091b\u0921\u0947-\u092c\u0932\u091b\u094d\u092f\u094b\u0902 \u0915 \u0947 \u0930\u0901\u092d\u093e\u0928 \u0947 \u0915 \u0947 \u0938\u0935\u0930 \u0909\u0920\u0924\u0947 \u0939\u0948\u0902\u0964) \u093f\u0916\u0927\u093e - \u0939\u0927\u093e\u0901 \u0915\u0924\u0941\u092e\u0927\u093e\u0930!",
    "\u092d\u0932\u0927\u093e \u0915\u0924\u0941\u092e\u0927\u093e\u0930, \u0935\u0947 \u0915\u0948\u093f\u0947 \u091c\u0927\u093e\u0928\u094d\u0947 \u0939\u0948\u0902 \u0938\u0915 \u092f\u0939 \u093f\u092e\u092f \u0909\u0928\u0915\u0940 \u092e\u0927\u093e\u0901\u0913\u0902 \u0915\u0947 \u0918\u0930 \u0932\u094c\u091f\u0928\u0947 \u0915\u0927\u093e \u0939\u0948?",
    "\u0926\u0947\u0916\u0927\u094b \u0928, \u093f\u0942\u0930\u091c \u0930\u0927\u094b\u091c \u093f\u0935\u0947\u0930\u0947 \u093f\u0942\u0930\u092c \u093f\u0947 \u0938\u0928\u0915\u0932\u094d\u0927\u093e \u0939\u0948 \u0914\u0930 \u0936\u0927\u093e\u092e \u0915\u0927\u094b \u093f\u0938\u0936\u094d \u091a\u092e \u092e\u0947\u0902 \u0938\u091b\u093f \u091c\u0927\u093e\u094d\u0927\u093e \u0939\u0948\u0964"
  ],
  "source_text_character_count": 17700
}