          "\u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0915\u093e \u091c\u0940\u0935\u0928 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0938\u0902\u0917\u0940\u0924 \u0915\u0947 \u0930\u093e\u0917\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0928 \u0939\u0940 \u0909\u0924\u093e\u0930-\u091a\u095d\u093e\u0935 \u092d\u0930\u093e \u0925\u093e\u0964",
          "\u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0938\u092b\u0932\u0924\u093e\u0913 \u0902 \u0915\u0947 \u093f\u0932\u090f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u093f\u0920\u0928 \u0938\u093e\u0927\u0928\u093e \u0915\ufffd \u0925\u0940\u0964",
