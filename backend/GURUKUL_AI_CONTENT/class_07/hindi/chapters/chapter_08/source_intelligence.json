  "subject": "Hindi",
  "chapter_number": 108,
  "chapter_title": "\u092c\u093f\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0938\u0947 \u0938\u093e\u0915\u094d\u0937\u093e\u0924\u094d\u0915\u093e\u0930",
  "source_pdf": "ghml108.pdf",
  "pages": 20,
  "source_text_file": "SOURCE_TEXT/Hindi_ghml108.txt",
  "source_key_points": [
    "8 \u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0938\u0947 \u0938\u093e\u0915\u094d\u0937\u093e\ufffd\u093e\u0930 \u0915\u0925\u0915 \u0915\ufffd \u091c\u092c \u092d\u0940 \u092c\u093e\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0924\u094b \u0939\u092e\u093e\u0930\u0947 \u092e\u093f\u0938\u094d\u0924\u0937\u094d\u0915 \u092e\u0947\u0902 \u090f\u0915 \u0928\u093e\u092e \u0905\u0935\u0936\u094d\u092f \u0906\u0924\u093e \u0939\u0948\u2014 \u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c\u0964",
    "\u0915\u0925\u0915 \u0915\ufffd \u0915\u0932\u093e \u0909\u0928\u094d\u0939\u0947\u0902 \u093f\u0935\u0930\u093e\u0938\u0924 \u092e\u0947\u0902 \u093f\u092e\u0932\u0940 \u0925\u0940, \u092d\u093e\u0930\u0924 \u0939\u0940 \u0928\u0939\u0940\u0902 \u092c\u093f\u0932\u094d\u0915 \u093f\u0935\u0926\u0947\u0936\u094b\u0902 \u092e\u0947\u0902 \u092d\u0940 \u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0915\u093e \u0938\u094d\u092e\u0930\u0923 \u0909\u0928\u0915\ufffd \u092e\u0928\u092e\u094b\u0939\u0915 \u092a\u094d\u0930\u0938\u094d\u0924\u093f\u0941 \u0924\u092f\u094b\u0902 \u0915\u0947 \u093f\u0932\u090f \u093f\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0915\u093e \u091c\u0940\u0935\u0928 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0938\u0902\u0917\u0940\u0924 \u0915\u0947 \u0930\u093e\u0917\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0928 \u0939\u0940 \u0909\u0924\u093e\u0930-\u091a\u095d\u093e\u0935 \u092d\u0930\u093e \u0925\u093e\u0964",
    "\u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0938\u092b\u0932\u0924\u093e\u0913 \u0902 \u0915\u0947 \u093f\u0932\u090f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u093f\u0920\u0928 \u0938\u093e\u0927\u0928\u093e \u0915\ufffd \u0925\u0940\u0964",
    "\u093f\u091c\u0928 \u093f\u0921\u092c\u094d\u092c\u094b\u0902 \u092e\u0947\u0902 \u0915\u092d\u0940 \u0924\u0940\u0928-\u091a\u093e\u0930 \u0932\u093e\u0916 \u0915\ufffd \u0915\ufffd\u092e\u0924 \u0915\u0947 \u0939\u093e\u0930 \u0939\ufffd\u0906 \u0915\u0930\u0924\u0947 \u0925\u0947 \u0935\u0947 \u0905\u092c \u0916\u093e\u0932\u0940 \u092a\u095c\u0947 \u0925\u0947\u0964",
    "\u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0909\u0924\u093e\u0930-\u091a\u095d\u093e\u0935 Reprint 2026-27 Chapter 08.indd 96 04-04-2025 17:05:35 \u0924\u094b \u0939\u094b\u0924\u093e \u0939\u0940 \u0939\u0948\u0964",
    "\u0915\u092d\u0940 \u0915\u091c\u0930\u094d \u0932\u0947\u0924\u0947 \u0925\u0947 \u0924\u094b \u0915\u092d\u0940 \u092a\u0930\u0941 \u093e\u0928\u0940 \u095b\u0930\u0940 \u0915\ufffd \u0938\u093e\u093f\u095c\u092f\u093e\u0901 \u091c\u0932\u093e\u0915\u0930 \u0909\u0928\u0915\u0947 \u0938\u094b\u0928\u0947-\u091a\u093e\u0901\u0926\u0940 \u0915\u0947 \u0924\u093e\u0930 \u092c\u0947\u091a\u0924\u0947 \u0925\u0947 \u0914\u0930 \u0917\u091c\u0941 \u093e\u0930\u093e \u0915\u0930\u0924\u0947 \u0925\u0947\u0964",
    "\u0905\u092e\u094d\u092e\u093e \u092c\u093e\u0930-\u092c\u093e\u0930 \u092f\u0939\u0940 \u0915\u0939\u093e \u0915\u0930\u0924\u0940 \u0925\u0940\u0902, \u201c\u0916\u093e\u0928\u0947 \u0915\u094b \u092d\u0932\u0947 \u0939\u0940 \u091a\u0928\u093e \u093f\u092e\u0932\u0947 \u092f\u093e \u0915\u0941\u091b \u092d\u0940 \u0928 \u093f\u092e\u0932\u0947 \u092a\u0930 \u0905\u092d\u094d\u092f\u093e\u0938 \u091c\u0930\u0942\u0930 \u0915\u0930\u094b\u0964\u201d \u0924\u0928\u0941\u0936\u094d\u0930\u0940 \u0906\u092a\u0928\u0947 \u0915\u0925\u0915 \u093f\u0915\u0938\u0938\u0947 \u0938\u0940\u0916\u093e?",
    "\u093f\u092c\u0930\u091c\u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u092e\u0947\u0930\u0947 \u0917\u0930\u0941\u0941 \u0925\u0947 \u092e\u0947\u0930\u0947 \u093f\u092a\u0924\u093e \u0905\u091a\u094d\u091b\u0928 \u092e\u0939\u093e\u0930\u093e\u091c \u0914\u0930 \u091a\u093e\u091a\u093e \u0936\u092d\u0902 \u0942 \u092e\u0939\u093e\u0930\u093e\u091c \u0914\u0930 \u0932\u091a\u094d\u091b\u0942 \u092e\u0939\u093e\u0930\u093e\u091c\u0964",
    "\u0918\u0930 \u092e\u0947\u0902 \u091a\u093f\u0901\u0942 \u0915 \u0915\u0925\u0915 \u0915\u093e \u092e\u093e\u0939\u094c\u0932 \u0925\u093e, \u0905\u0924: \u0914\u092a\u091a\u093e\ufffd\u0930\u0915 \u092a\u094d\u0930\u093f\u0936\u0915\u094d\u0937\u0923 \u0936\u0930\u0942 \u0941 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092e\u0948\u0902 \u0926\u0947\u0916-\u0926\u0947\u0916\u0915\u0930 \u0915\u0925\u0915 \u0938\u0940\u0916 \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \u0928\u0935\u093e\u092c \u0915\u0947 \u0926\u0930\u092c\u093e\u0930 \u092e\u0947\u0902 \u0928\u093e\u091a\u0928\u0947 \u092d\u0940 \u0932\u0917\u093e \u0925\u093e\u0964"
  ]
}