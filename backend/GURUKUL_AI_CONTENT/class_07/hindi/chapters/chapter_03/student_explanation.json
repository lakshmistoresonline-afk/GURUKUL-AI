    "key_points": [
      "3 \u092b\u0942\u0932 \u0914\u0930 \u0915\u093e\u0901\u091f\u093e \u0939\u0948\u0902 \u091c\u0928\u092e \u0932\u0947\u0924\u0947 \u091c\u0917\u0939 \u092e\u0947\u0902 \u090f\u0915 \u0939\u0940, \u090f\u0915 \u0939\u0940 \u092a\u094c\u0927\u093e \u0909\u0928\u094d\u0939\u0947\u0902 \u0939\u0948 \u092a\u093e\u0932\u0924\u093e\u0964",
      "\u092a\u094d\u092f\u093e\u0930-\u0921\u0942\u092c\u0940 \u093f\u0924\u0924\u093f\u0932\u092f\u094b\u0902 \u0915\u093e \u092a\u0930 \u0915\u0924\u0930, \u092d\u094c\u0902\u0930 \u0915\u093e \u0939\u0948 \u092c\u0947\u0927 \u0926\u0947\u0924\u093e \u0936\u094d\u092f\u093e\u092e \u0924\u0928\u0964",
      "\u2014 \u0905\u092f\u094b\u0927\u094d\u092f\u093e\u093f\u0938\u0939\u0902 \u0909\u092a\u093e\u0927\u094d\u092f\u093e\u092f \u2018\u0939\ufffd\u0930\u0914\u0927\u2019 Reprint 2026-27 Chapter 03.indd 29 04-04-2025 15:07:00 \u0915\u093f\u0935 \u0938\u0947 \u092a\ufffd\u0930\u091a\u092f \u2018\u0909\u0920\u094b \u0932\u093e\u0932, \u0905\u092c \u0906\u0901\u0916\u0947\u0902 \u0916\u094b\u0932\u094b\u0964",
      "\u092a\u093e\u0928\u0940 \u0932\u093e\u0908 \u0939\ufffd,\u0901 \u092e\u0939\u0901\u0941 \u0927\u094b \u0932\u094b\u0964\u2019 \u092c\u091a\u092a\u0928 \u092e\u0947\u0902 \u092f\u0939 \u092a\u094d\u092f\u093e\u0930\u0940 \u0915\u093f\u0935\u0924\u093e \u0906\u092a\u0928\u0947 \u092d\u0940 \u092a\u095d\u0940 \u0939\u094b\u0917\u0940\u0964",
      "\u0907\u0938 \u0915\u093f\u0935\u0924\u093e \u0915\u094b \u0930\u091a\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u092f\u094b\u0927\u094d\u092f\u093e\u093f\u0938\u0902\u0939 \u0909\u092a\u093e\u0927\u094d\u092f\u093e\u092f \u2018\u0939\ufffd\u0930\u0914\u0927\u2019 \u0939\u0940 \u2018\u092b\u0942\u0932 \u0914\u0930 \u0915\u093e\u0901\u091f\u093e\u2019 \u0915\u0947 \u0915\u093f\u0935 \u0939\u0948\u0902\u0964",
      "\u0939\ufffd\u0930\u0914\u0927 \u091c\u0940 \u0915\ufffd \u091a\u093f\u091a\u0930\u094d\u0924 \u0915\u093e\u0935\u094d\u092f-\u0915\u0943 \u093f\u0924 \u093f\u092a\u094d\u0930\u092f\u092a\u094d\u0930\u0935\u093e\u0938 \u0915\u094b \u0916\u095c\u0940 \u092c\u094b\u0932\u0940 \u0915\u093e \u092a\u0939\u0932\u093e \u092e\u0939\u093e\u0915\u093e\u0935\u094d\u092f \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
    ]
