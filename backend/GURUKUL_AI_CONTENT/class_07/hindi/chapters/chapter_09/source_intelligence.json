  "chapter_title": "\u091a\u093f\u0921\u093c\u093f\u092f\u093e",
  "source_pdf": "ghml109.pdf",
  "pages": 12,
  "source_text_file": "SOURCE_TEXT/Hindi_ghml109.txt",
  "source_key_points": [
    "\u0935\u0928 \u092e\u0947\u0902 \u093f\u091c\u0924\u0928\u0947 \u092a\u0902\u091b\u0940 \u0939\u0948\u0902, \u0916\u091c\u0902 \u0928, \u0915\u092a\u094b\u0924, \u091a\u093e\u0924\u0915, \u0915\u094b\u093f\u0915\u0932; \u0915\u093e\u0915, \u0939\u0938\u0902 , \u0936\u0915 \u0941 \u0906\u093f\u0926 \u0935\u093e\u0938 \u0915\u0930\u0924\u0947 \u0938\u092c \u0906\u092a\u0938 \u092e\u0947\u0902 \u093f\u0939\u0932\u093f\u092e\u0932!",
    "\u0938\u092c \u093f\u092e\u0932-\u091c\u0932 \u0941 \u0915\u0930 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902 \u0935\u0947, \u0938\u092c \u093f\u092e\u0932-\u091c\u0932\u0941 \u0915\u0930 \u0916\u093e\u0924\u0947 \u0939\u0948\u0902; \u0906\u0938\u092e\u093e\u0928 \u0939\u0940 \u0909\u0928\u0915\u093e \u0918\u0930 \u0939\u0948; \u091c\u0939\u093e\u0901 \u091a\u093e\u0939\u0924\u0947, \u091c\u093e\u0924\u0947 \u0939\u0948\u0902!",
    "\u0930\u0939\u0924\u0947 \u091c\u0939\u093e\u0901, \u0935\u0939\u093e\u0901 \u0935\u0947 \u0905\u092a\u0928\u0940 \u0926\u093f\u0941 \u0928\u092f\u093e \u090f\u0915 \u092c\u0938\u093e\u0924\u0947 \u0939\u0948\u0902; \u093f\u0926\u0928 \u092d\u0930 \u0915\u0930\u0924\u0947 \u0915\u093e\u092e, \u0930\u093e\u0924 \u092e\u0947\u0902 \u092a\u0947\u095c\u094b\u0902 \u092a\u0930 \u0938\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902!",
    "\u091c\u094b \u093f\u092e\u0932\u0924\u093e \u0939\u0948 \u0905\u092a\u0928\u0947 \u0936\u094d\u0930\u092e \u0938\u0947, \u0909\u0924\u0928\u093e \u092d\u0930 \u0932\u0947 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902; \u092c\u091a \u091c\u093e\u0924\u093e \u091c\u094b, \u0914\u0930\u094b\u0902 \u0915\u0947 \u093f\u0939\u0924, \u0909\u0938\u0947 \u091b\u094b\u095c \u0935\u0947 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902!",
    "\u0938\u0940\u092e\u093e-\u0939\u0940\u0928 \u0917\u0917\u0928 \u092e\u0947\u0902 \u0909\u095c\u0924\u0947, \u093f\u0928\u092d\u0930\u094d\u092f \u093f\u0935\u091a\u0930\u0923 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902; \u0928\u0939\u0940\u0902 \u0915\u092e\u093e\u0908 \u0938\u0947 \u0914\u0930\u094b\u0902 \u0915\ufffd \u0905\u092a\u0928\u093e \u0918\u0930 \u0935\u0947 \u092d\u0930\u0924\u0947 \u0939\u0948\u0902!",
    "\u0938\u0940\u0916\u094b \u0924\u092e\u0941 \u0939\u092e\u0938\u0947 \u091c\u0940\u0928\u093e \u091c\u0917 \u092e\u0947\u0902; \u0939\u092e \u0938\u094d\u0935\u091a\u094d\u091b\u0902\u0926 \u0914\u0930 \u0915\u094d\u092f\u094b\u0902 \u0924\u092e\u0941 \u0928\u0947 \u0921\u093e\u0932\u0940 \u0939\u0948 \u092c\u0947\u095c\u0940 \u092a\u0917 \u092e\u0947\u0902?",
    "\u092a\u0940\u092a\u0932 \u0915\ufffd \u0921\u093e\u0932\u0940 \u092a\u0930 \u093f\u091a\u093f\u095c\u092f\u093e \u092f\u0939\u0940 \u0938\u0928\u0941 \u093e\u0928\u0947 \u0906\u0924\u0940 \u0939\u0948 \u092c\u0948\u0920 \u0918\u095c\u0940 \u092d\u0930, \u0939\u092e\u0947\u0902 \u091a\u093f\u0915\u0924 \u0915\u0930, \u0917\u093e-\u0915\u0930 \u093f\u092b\u0930 \u0909\u095c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u2014 \u0906\u0930\u0938\u0940 \u092a\u094d\u0930\u0938\u093e\u0926 \u093f\u0938\u0902\u0939 \u093f\u091a\u093f\u095c\u092f\u093e 117 Reprint 2026-27 Chapter 09.indd 117 04-04-2025 17:08:28 \u0915\u093f\u0935 \u0938\u0947 \u092a\ufffd\u0930\u091a\u092f \u0906\u0930\u0938\u0940 \u092a\u094d\u0930\u0938\u093e\u0926 \u093f\u0938\u0902\u0939 \u092a\u094d\u0930\u0915\u0943 \u093f\u0924 \u0914\u0930 \u091c\u0940\u0935\u0928-\u0938\u0902\u0918\u0937\ufffd \u0915\u094b \u0905\u092a\u0928\u0940 \u0930\u091a\u0928\u093e\u0913 \u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u092e\u0916 \u0941 \u0924\u093e \u0938\u0947 \u093f\u091a\u093f\u0924\u094d\u0930\u0924 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093f\u0935 \u0939\u0948\u0902\u0964",
    "\u0935\u0947 \u0905\u092a\u0928\u0940 \u0930\u091a\u0928\u093e\u0913 \u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0947\u092e, \u0915\u0930\u0941\u0923\u093e, \u0924\u094d\u092f\u093e\u0917-\u092c\u093f\u0932\u0926\u093e\u0928, \u092e\u093f\u0941 \u0915\u094d\u0924 \u0914\u0930 \u093f\u092e\u0932-\u091c\u0932 \u0941 \u0915\u0930 \u090f\u0915 \u0938\u0902\u0926\u0941 \u0930 \u0938\u0902\u0938\u093e\u0930 \u0930\u091a\u0928\u0947 \u0915\ufffd \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0924\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u093f\u091a\u093f\u095c\u092f\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u093f\u0915\u0924\u0928\u0940 \u0938\u0926\u0902\u0941 \u0930 \u092c\u093e\u0924 \u0915\u0939\u0940 \u0939\u0948\u2014 \u201c\u093f\u091a\u093f\u095c\u092f\u093e \u092c\u0948\u0920\u0940 \u092a\u094d\u0930\u0947\u092e-\u092a\u094d\u0930\u0940\u093f\u0924 \u0915\ufffd \u0930\u0940\u093f\u0924 \u0939\u092e\u0947\u0902 \u093f\u0938\u0916\u0932\u093e\u0924\u0940 \u0939\u0948!"
  ]
}