import os
import json
import logging
import re
from typing import Optional, Dict, Any, List
from functools import lru_cache
from ..config.app_config import settings

logger = logging.getLogger(__name__)

class PathResolver:
    """
    Resolves canonical identifiers to filesystem paths in the Master Content Package.
    Handles mapping between:
    - class_5 -> Class 5
    - index lookup for chapters
    """

    @staticmethod
    def extract_class_id(name: str) -> str:
        """Extracts the numeric part of a class identifier (e.g. 'class_5' -> '5')."""
        if not name: return ""
        match = re.search(r'(\d+)', str(name))
        if match:
            return match.group(1)
        # Fallback to splitting by underscore
        if '_' in str(name):
            return name.split('_')[1]
        return str(name)

    @staticmethod
    @lru_cache(maxsize=4)
    def _get_master_index(class_id: str) -> Optional[Dict[str, Any]]:
        """Loads the Master Index for a given class ID (e.g., '5')."""
        # Try both 'Class 5' and 'class_5' folder styles
        possible_folders = [f"Class {class_id}", f"class_{class_id}", f"Class_{class_id}", str(class_id)]

        for folder in possible_folders:
            folder_path = os.path.join(settings.MASTER_CONTENT_ROOT, folder)
            if not os.path.exists(folder_path):
                continue

            # Index file might be Class_5_Master_Index.json
            index_file = os.path.join(folder_path, f"Class_{class_id}_Master_Index.json")
            if os.path.exists(index_file):
                try:
                    with open(index_file, 'r', encoding='utf-8') as f:
                        data = json.load(f)
                        logger.info(f"PathResolver: Loaded master index from {index_file}")
                        return data
                except Exception as e:
                    logger.error(f"PathResolver: Error loading index {index_file}: {e}")

        logger.warning(f"PathResolver: Master index not found for class_id {class_id} in {settings.MASTER_CONTENT_ROOT}")
        return None

    @staticmethod
    def get_chapter_path(class_name: str, chapter_id: str) -> Optional[str]:
        """Resolves the absolute path to a chapter directory in the master package."""
        class_id = PathResolver.extract_class_id(class_name)
        index = PathResolver._get_master_index(class_id)
        if not index:
            return None

        for chapter in index.get("chapters", []):
            if chapter.get("chapterId") == chapter_id:
                rel_path = chapter["path"]
                # index path usually points to package.json, we want the directory
                return os.path.join(settings.MASTER_CONTENT_ROOT, os.path.dirname(rel_path))

        return None

    @staticmethod
    def get_class_hierarchy(class_name: str) -> Dict[str, List[Dict[str, Any]]]:
        """Returns the Subject -> Chapter hierarchy for a class from the master index."""
        class_id = PathResolver.extract_class_id(class_name)
        index = PathResolver._get_master_index(class_id)
        if not index:
            return {}

        hierarchy = {}
        for chapter in index.get("chapters", []):
            # Use the canonical 'subject' (e.g. 'english') as the key for frontend consistency
            subj = chapter.get("subject", "unknown").lower()
            if subj not in hierarchy:
                hierarchy[subj] = []

            hierarchy[subj].append({
                "id": chapter.get("chapterId"),
                "name": chapter.get("chapterName"),
                "part": chapter.get("part"),
                "number": chapter.get("chapterNumber")
            })

        # Sort by part then number
        for subj in hierarchy:
            hierarchy[subj].sort(key=lambda x: (str(x.get("part") or ""), int(x.get("number") or 0)))

        return hierarchy

    @staticmethod
    def get_subject_list(class_name: str) -> List[str]:
        class_id = class_name.split('_')[1] if '_' in class_name else class_name
        index = PathResolver._get_master_index(class_id)
        if not index:
            return []
        return index.get("subjects", [])
