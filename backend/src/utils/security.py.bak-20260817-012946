from fastapi import Header, HTTPException, Query, Depends
from typing import Optional
import logging
from .auth import get_current_user, AuthUser

logger = logging.getLogger(__name__)

async def get_authorized_class(
    user: AuthUser = Depends(get_current_user),
    class_name: Optional[str] = None
) -> str:
    """
    Enforces that student requests are scoped to their own class.
    Derived from the verified Firebase Auth session.
    """
    student_class = user.class_name

    if class_name and class_name != student_class:
        logger.error(f"Unauthorized class access attempt by UID {user.uid}: Requested {class_name}, but authorized for {student_class}")
        raise HTTPException(status_code=403, detail="Access Denied: You are not authorized to access content for this class.")

    return student_class

def validate_chapter_access(chapter_id: str, student_class: str):
    """
    Validates that a specific chapter ID belongs to the authorized class.
    """
    prefix_map = {
        "class_5": "e",
        "class_6": "f",
        "class_7": "g",
        "class_8": "h"
    }

    expected_prefix = prefix_map.get(student_class)
    if expected_prefix and not chapter_id.startswith(expected_prefix):
        logger.error(f"Cross-class chapter access attempt: Chapter {chapter_id} requested by {student_class}")
        raise HTTPException(status_code=403, detail="Access Denied: Requested chapter does not belong to your curriculum.")

async def get_admin_user(
    user: AuthUser = Depends(get_current_user)
) -> str:
    """
    Enforces that only admin users can access the endpoint.
    Returns the admin user ID.
    """
    if user.role != 'admin':
        logger.error(f"Unauthorized admin access attempt by UID: {user.uid} with role: {user.role}")
        raise HTTPException(status_code=403, detail="Access Denied: Admin role required.")

    return user.uid
