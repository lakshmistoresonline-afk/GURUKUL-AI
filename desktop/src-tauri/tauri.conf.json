{
  "productName": "Gurukul AI",
  "version": "1.0.0",
  "identifier": "com.gurukul.ai",
  "build": {
    "frontendDist": "../../frontend-nextjs/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../frontend-nextjs run dev",
    "beforeBuildCommand": "npm --prefix ../frontend-nextjs run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gurukul AI",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Gurukul AI",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    }
  }
}
