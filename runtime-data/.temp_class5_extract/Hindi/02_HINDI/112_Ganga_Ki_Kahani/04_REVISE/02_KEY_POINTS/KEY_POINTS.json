  "enriched_items": [
    {
      "id": "112-R01",
      "content": "गंगा का उद्गम हिमालय क्षेत्र में गंगोत्री हिमनद के गोमुख से बताया गया है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R02",
      "content": "गंगोत्री में गंगा से जुड़ा प्रसिद्ध मंदिर है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R03",
      "content": "गंगा को भागीरथी नाम से भी संबोधित किया गया है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R04",
      "content": "देवप्रयाग में अलकनंदा गंगा से मिलती है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R05",
      "content": "ऋषिकेश के बाद गंगा मैदानों की ओर आती है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R06",
      "content": "हरिद्वार गंगा के किनारे स्थित प्रसिद्ध तीर्थ है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R07",
      "content": "वाराणसी का दूसरा नाम काशी बताया गया है।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "112-R08",
      "content": "अध्याय में नदी, नगर, जल-प्रदूषण, संरक्षण और आगे गगनयान जैसे ज्ञान-विस्तार विषय भी आते हैं।",
      "source_ref": "ehve112.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}