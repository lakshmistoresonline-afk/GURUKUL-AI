    },
    {
      "record_id": "class_7_02_hindi_grade7_complete_109_practice_04_SOURCE_DERIVED_0001_030d0c326759bebcb5e3",
      "chapter_id": "109",
      "chapter_title": "",
      "pillar": "practice",
      "asset": "04_SOURCE_DERIVED",
      "type": "paragraph",
      "text": "आइए, अब हम इस किवता पर िवस्तार से चचार् करें । आगे दी गई गितिविधयाँ इस कायर् में आपक�\nसहायता करें गी।\n1. किवता के आधार पर बताइए िक इनमें से कौन-सा गणुु पिक्षयों के जीवन में नहीं पाया जाता है?\n(ख) अब अपने िमत्रों के साथ िमलकर चचार् क�िजए और कारण बताइए िक आपने ये उ�र ही क्यों चनु े?\nिमलकर करें िमलान\nऔर बताइए। आप नीचे िदए गए भावों में से शब्द चनु सकते हैं। आप िकसी भी दृश्य के िलए एक से\nइन तीनों िचत्रों को ध्यान से देिखए और बताइए—\nआप पिक्षयों को इनमें से कहाँ देखना पसंद करें गे और क्यों?\nहैं िक एक ही शब्द दसू रे सदं भर् में अलग-अलग अथर् दे रहा है। आइए, इससे सबं ंिधत एक और रोचक उदाहरण\n(ख) सभी िवद्याथ� ‘पयार्वरण बचाओ’ िवषय पर एक नक्ु कड़ नाटक तैयार करें और उसक� प्रस्तिु त िवद्यालय\nप्रांगण में करें ।",
      "resource_category": "STANDARD_CONTENT",
      "visibility": "student",
      "student_facing": true,
      "content_origin": "SOURCE_PRESERVED",
      "status": "SOURCE_PRESERVED",
