      "id": "class05_01_english_101_learn_1_54cc1c4d",
      "type": "poem",
      "text": "Today our papa\nIs searching everywhere,\nHe has lost his spectacles,\nIt was his only pair!",
      "answer": null,
      "source": {
        "file": "01_LEARN\\01_LESSONS\\LESSONS.json",
        "page": 1
      },
      "order": 2
    },
    {
