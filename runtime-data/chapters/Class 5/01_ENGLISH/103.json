    {
      "id": "class05_01_english_103_learn_24_404e1aa8",
      "type": "paragraph",
      "text": "Recite the poem given below in three ways:\na.   In a happy voice\nb.   In an angry voice\nc.   In a surprised voice",
      "answer": null,
      "source": {
        "file": "01_LEARN\\01_LESSONS\\LESSONS.json",
        "page": 5
