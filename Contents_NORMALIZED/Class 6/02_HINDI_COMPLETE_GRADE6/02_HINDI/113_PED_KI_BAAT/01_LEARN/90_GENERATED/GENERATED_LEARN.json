  "items": [
    {
      "title": "पेड़ की कहानी",
      "explanation": "बीज मिट्टी के नीचे पड़ता है और वर्षा के बाद ऊपर निकलकर जड़, तना और पत्तियाँ बनाता है। पेड़ का भोजन माटी से रस-पान करके जड़ों द्वारा होता है।",
      "id": "113_learn_001",
      "content_origin": "GENERATED",
      "source_ref": null,
      "chapter_id": "113",
      "source_bundle_sha256": "b135419ddb9ae9ce82287281cfaf91c7ab6fa9bfe3f84a25c36bef0ec3dd1d77"
    },
    {
      "title": "जड़ और तना",
      "explanation": "पेड़ के बीज से निकलने पर जड़ नीचे की ओर जाती है और तना ऊपर की ओर बढ़ता है। यह दो भाग मिलकर पेड़ का शरीर बनाते हैं।",
      "id": "113_learn_002",
      "content_origin": "GENERATED",
      "source_ref": null,
      "chapter_id": "113",
      "source_bundle_sha256": "b135419ddb9ae9ce82287281cfaf91c7ab6fa9bfe3f84a25c36bef0ec3dd1d77"
    },
    {
      "title": "पौधे का भोजन",
      "explanation": "पेड़ के दांत नहीं होते, इसलिए वे वल तरल द्रव्य या वायु से भोजन करते हैं। जड़ माटी से रस-पान करके पेड़ को पोषक तत्व देती है।",
      "id": "113_learn_003",
      "content_origin": "GENERATED",
      "source_ref": null,
      "chapter_id": "113",
      "source_bundle_sha256": "b135419ddb9ae9ce82287281cfaf91c7ab6fa9bfe3f84a25c36bef0ec3dd1d77"
    },
    {
      "title": "रस का संचार",
      "explanation": "पेड़ की डाल या जड़ का यंत्र द्वारा परीक्षण करके देखा जा सकता है कि पेड़ में हज़ारों नलों से रस का संचार होता है।",
      "id": "113_learn_004",
      "content_origin": "GENERATED",
      "source_ref": null,
      "chapter_id": "113",
      "source_bundle_sha256": "b135419ddb9ae9ce82287281cfaf91c7ab6fa9bfe3f84a25c36bef0ec3dd1d77"
    },
    {
      "title": "प्रकाश और जीवन",
      "explanation": "पेड़ के पत्ते हवा से आहार ग्रहण करते हैं, जबकि जड़ माटी से रस-पान करके पोषक तत्व लेती है। प्रकाश ही पेड़ की सबसे बड़ी आवश्यकता है।",
