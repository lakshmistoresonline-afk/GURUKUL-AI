  "enriched_items": [
    {
      "id": "102-R01",
      "content": "लड़कों ने एक पत्थर को सिंहासन मानकर खेल शुरू किया।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R02",
      "content": "लड़का राजा बनकर काल्पनिक फरियाद सुनता और फैसला करता था।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R03",
      "content": "लोग उसकी न्याय-बुद्धि की चर्चा करने लगे।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R04",
      "content": "दो किसानों का भूमि-विवाद लड़के के पास आया।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R05",
      "content": "राजा ने लड़के की बुद्धिमानी देखकर पत्थर की कुर्सी की जाँच करवाई।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R06",
      "content": "पत्थर राजा विक्रमादित्य के पुराने सिंहासन से जुड़ा था।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R07",
      "content": "सिंहासन की मूर्तियाँ राजा को उसकी योग्यता और न्याय के बारे में प्रश्न करती हैं।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "102-R08",
      "content": "राजा ने अपनी गलती स्वीकार की और प्रायश्चित किया।",
      "source_ref": "ehve102.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}