  "enriched_items": [
    {
      "id": "106-R01",
      "content": "चित्रकार सुनसान जगह में चित्र बना रहा था।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R02",
      "content": "यमराज का मित्र वहाँ आ गया और चित्रकार घबरा गया।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R03",
      "content": "चित्रकार ने संकट में भी चित्र बनाने का उपाय सोचा।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R04",
      "content": "वह शेर को बैठाकर चित्र बनाने का बहाना करता है।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R05",
      "content": "चित्रकार धीरे-धीरे शेर की पीठ की ओर खिसकता है।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R06",
      "content": "झील के किनारे नाव देखकर चित्रकार को बच निकलने का अवसर मिलता है।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R07",
      "content": "चित्रकार नाव लेकर दूर निकल जाता है।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "106-R08",
      "content": "कहानी में बुद्धि, सूझ-बूझ और संकट में धैर्य का महत्व दिखता है।",
      "source_ref": "ehve106.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}