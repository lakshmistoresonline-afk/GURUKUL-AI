  "enriched_items": [
    {
      "id": "105-R01",
      "content": "हीरासिंह हरियाणा के एक गाँव का किसान है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R02",
      "content": "सुंदरिया उसकी प्यारी गाय है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R03",
      "content": "गरीबी के कारण हीरासिंह गाय का चारा जुटाने में कठिनाई महसूस करता है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R04",
      "content": "हीरासिंह नौकरी की तलाश में दिल्ली जाता है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R05",
      "content": "सेठ हीरासिंह की ईमानदारी से प्रभावित होता है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R06",
      "content": "हीरासिंह सुंदरिया को परिवार का सदस्य मानता है।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R07",
      "content": "सुंदरिया नए व्यक्ति के साथ जाने में सहज नहीं होती।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "105-R08",
      "content": "कहानी में ईमानदारी, लगाव और जिम्मेदारी प्रमुख विचार हैं।",
      "source_ref": "ehve105.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}