  "enriched_items": [
    {
      "id": "103-R01",
      "content": "चाँद अपनी माँ से ऊन का मोटा झिंगोला सिलवाने की हठ करता है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R02",
      "content": "चाँद को रात की ठंडी हवा से ठिठुरन महसूस होती है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R03",
      "content": "चाँद की माँ कहती है कि उसका आकार रोज बदलता रहता है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R04",
      "content": "चाँद कभी छोटा और कभी बड़ा दिखाई देता है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R05",
      "content": "चाँद की बदलती आकृति के कारण एक ही नाप का कुरता कठिन है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R06",
      "content": "कविता में आकाश और मौसम की कल्पना का प्रयोग हुआ है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R07",
      "content": "अध्याय में आकाश में होने वाले परिवर्तनों पर बातचीत की गतिविधियाँ हैं।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "103-R08",
      "content": "भाषा की गतिविधियों में शब्दों के प्रयोग और अर्थ पर ध्यान दिया गया है।",
      "source_ref": "ehve103.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}