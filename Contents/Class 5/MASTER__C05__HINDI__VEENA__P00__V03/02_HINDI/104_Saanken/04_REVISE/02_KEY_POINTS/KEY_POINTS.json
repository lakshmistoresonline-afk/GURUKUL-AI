  "enriched_items": [
    {
      "id": "104-R01",
      "content": "कहानी की पृष्ठभूमि अरुणाचल प्रदेश के चौखाम से जुड़ी है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R02",
      "content": "वल्लरी अपने पिता के साथ चौखाम में रहती है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R03",
      "content": "चौखाम का वातावरण दिल्ली की भीड़ से अलग शांत और हरियाली से भरा बताया गया है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R04",
      "content": "वल्लरी का मित्र चाऊतान उसे अपने घर बुलाता है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R05",
      "content": "कहानी में एक शोभायात्रा का वर्णन है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R06",
      "content": "शोभायात्रा में बुद्ध और उनके शिष्यों की मूर्तियाँ ले जाई जा रही थीं।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R07",
      "content": "लोग नाचते-गाते और उत्साह से शोभायात्रा में भाग लेते हैं।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "104-R08",
      "content": "अध्याय विभिन्न क्षेत्रों की जीवन-शैली और सांस्कृतिक अनुभवों से परिचित कराता है।",
      "source_ref": "ehve104.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}