  "enriched_items": [
    {
      "id": "101-R01",
      "content": "कविता में किरन को सुबह आने वाली किरण के रूप में देखा गया है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R02",
      "content": "बालिका देर तक परी-कथाएँ पढ़ने के कारण देर से सोती है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R03",
      "content": "किरन बच्चों को जगाने का काम करती है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R04",
      "content": "कविता में किरन दिन और दूसरी दुनिया की कल्पना से जुड़ी है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R05",
      "content": "कविता में सुबह और शाम के समय का उल्लेख है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R06",
      "content": "भाषा की बात में समानार्थी और विलोम शब्दों का अभ्यास है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R07",
      "content": "सामान्य कथन को कविता का रूप देने की गतिविधि दी गई है।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "101-R08",
      "content": "अध्याय में दिन-रात और पृथ्वी-सूर्य से जुड़े तथ्य भी दिए गए हैं।",
      "source_ref": "ehve101.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}