  "enriched_items": [
    {
      "id": "109-R01",
      "content": "नाटक के पात्रों में सिद्धार्थ, देवदत्त, शुद्धोधन, मंत्री, सखा और प्रतिहारी शामिल हैं।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R02",
      "content": "सिद्धार्थ प्रकृति और जीवन की घटनाओं के कारणों पर प्रश्न करता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R03",
      "content": "सखा सूर्य के पूर्व से निकलने और पश्चिम में छिपने की बात बताता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R04",
      "content": "सिद्धार्थ हर वस्तु के स्वभाव के बारे में सोचता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R05",
      "content": "एक पक्षी तीर लगने से घायल होकर गिरता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R06",
      "content": "घायल पक्षी को देखकर सिद्धार्थ की चिंता और संवेदना सामने आती है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R07",
      "content": "नाटक संवाद और मंच-निर्देशों के माध्यम से आगे बढ़ता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "109-R08",
      "content": "अध्याय करुणा, जिज्ञासा और जीवों के प्रति संवेदनशीलता पर विचार कराता है।",
      "source_ref": "ehve109.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}