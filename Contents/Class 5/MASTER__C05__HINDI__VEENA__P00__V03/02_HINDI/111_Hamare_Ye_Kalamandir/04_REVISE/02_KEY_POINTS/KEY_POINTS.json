  "enriched_items": [
    {
      "id": "111-R01",
      "content": "निशा अपनी मौसी के साथ अजंता और एलोरा देखने जाती है।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R02",
      "content": "अजंता की गुफाओं में प्राचीन चित्र बने हैं।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R03",
      "content": "अजंता के चित्रों में बुद्ध के जीवन से जुड़े प्रसंगों के साथ प्रकृति और जीव-जंतुओं के चित्र भी हैं।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R04",
      "content": "अजंता के चित्रों के रंग बहुत लंबे समय बाद भी दिखाई देते हैं।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R05",
      "content": "एलोरा में पहाड़ों को काटकर अनेक मंदिर बनाए गए हैं।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R06",
      "content": "एलोरा की मूर्तियों में बौद्ध, हिंदू और जैन परंपराओं से जुड़े उदाहरण मिलते हैं।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R07",
      "content": "अध्याय भारतीय कला और सांस्कृतिक विरासत से परिचित कराता है।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "111-R08",
      "content": "अध्याय में यात्रा, अवलोकन और विरासत के संरक्षण की दृष्टि विकसित की जा सकती है।",
      "source_ref": "ehve111.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}