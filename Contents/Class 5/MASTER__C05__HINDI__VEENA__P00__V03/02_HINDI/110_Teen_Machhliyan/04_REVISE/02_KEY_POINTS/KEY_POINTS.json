  "enriched_items": [
    {
      "id": "110-R01",
      "content": "तीन मछलियों के नाम अनागतविधाता, प्रत्युत्पन्नमति और यद्भविष्य थे।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R02",
      "content": "अनागतविधाता संभावित समस्याओं का पहले से उपाय करती थी।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R03",
      "content": "प्रत्युत्पन्नमति तत्काल परिस्थिति के अनुसार उपाय करने में विश्वास करती थी।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R04",
      "content": "यद्भविष्य भाग्य पर निर्भर रहने की प्रवृत्ति रखती थी।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R05",
      "content": "मछुआरों ने सरोवर में बहुत-सी मछलियाँ देखीं।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R06",
      "content": "मछुआरों ने अगले दिन जाल लाकर मछलियाँ पकड़ने की योजना बनाई।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R07",
      "content": "अनागतविधाता और कई मछलियाँ दूसरे सरोवर में चली गईं।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "110-R08",
      "content": "कहानी तैयारी, सूझ-बूझ और निर्णय के परिणामों पर विचार कराती है।",
      "source_ref": "ehve110.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}