  "enriched_items": [
    {
      "id": "107-R01",
      "content": "लेखक अपने बचपन की यादों को आत्मीयता से याद करता है।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R02",
      "content": "वह अपने चचेरे भाई हलधर के साथ पढ़ने जाता था।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R03",
      "content": "बचपन में वह रामलीला देखने और छोटे काम करने में उत्साह दिखाता था।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R04",
      "content": "लेखक गिल्ली-डंडा को सभी खेलों में बहुत प्रिय मानता है।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R05",
      "content": "गिल्ली-डंडा खेलने के लिए महँगे सामान या विशेष मैदान की आवश्यकता नहीं होती।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R06",
      "content": "लेखक को इस खेल में अमीर-गरीब का भेद नहीं दिखाई देता था।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R07",
      "content": "बचपन की खेल-यादों में उत्साह, लगन और मित्रता दिखाई देती है।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    },
    {
      "id": "107-R08",
      "content": "अध्याय पारंपरिक खेल और बचपन के अनुभवों के मूल्य पर विचार कराता है।",
      "source_ref": "ehve107.pdf:page:1-3",
      "status": "ENRICHED_SOURCE_GROUNDED"
    }
  ]
}