{
  "subject": "Class 6 Mathematics",
  "resource_type": "Mind Maps",
  "chapters": [
    {
      "chapter_number": 1,
      "chapter_title": "Patterns in Mathematics",
      "mind_map": {
        "root_topic": "Patterns in Mathematics",
        "branches": [
          {
            "theme": "1.1 & 1.2 Number Sequences & Rules",
            "sub_branches": [
              {
                "concept_or_rule": "Counting, Even, Odd, and Power Sequences",
                "step_by_step_procedure": [
                  "Identify starting term and term-to-term rule.",
                  "Apply rule consistently to generate subsequent terms."
                ],
                "formulas_and_identities": [
                  "Even numbers: T_n = 2n",
                  "Odd numbers: T_n = 2n - 1",
                  "Powers of 2: P_n = 2^(n-1)",
                  "Powers of 3: P_n = 3^(n-1)"
                ],
                "example_problem": "Find 5th term of powers of 2 (1, 2, 4, 8, ...). Answer: 2^4 = 16."
              },
              {
                "concept_or_rule": "Virah\u0101nka (Fibonacci) Sequence",
                "step_by_step_procedure": [
                  "Set V_1 = 1, V_2 = 2.",
                  "Compute each next term by adding the two preceding terms."
                ],
                "formulas_and_identities": [
                  "V_n = V_{n-1} + V_{n-2} for n >= 3"
                ],
                "example_problem": "Find 6th Virah\u0101nka number: 1, 2, 3, 5, 8, 13. Answer: 13."
              }
            ]
          },
          {
            "theme": "1.3 & 1.4 Geometric Dot Patterns & Sequence Identities",
            "sub_branches": [
              {
                "concept_or_rule": "Square Numbers & L-Shaped Gnomon Partition",
                "step_by_step_procedure": [
                  "Arrange dots in an n x n square grid.",
                  "Partition into concentric L-shaped gnomon layers containing 1, 3, 5, ..., (2n-1) dots.",
                  "Sum gnomon layers to find total square array dots."
                ],
                "formulas_and_identities": [
                  "Sum of first n odd numbers: 1 + 3 + 5 + ... + (2n-1) = n^2"
                ],
                "example_problem": "Sum of first 10 odd numbers: 10^2 = 100."
              },
              {
                "concept_or_rule": "Triangular Numbers & Square Relation",
                "step_by_step_procedure": [
                  "Arrange dots in an equilateral triangle array with n dots on each side.",
                  "Sum consecutive triangular numbers T_n and T_{n-1} to form a full square array."
                ],
                "formulas_and_identities": [
                  "T_n = n(n + 1) / 2",
                  "T_n + T_{n-1} = n^2"
                ],
                "example_problem": "Sum T_3 (6) and T_4 (10). Answer: 6 + 10 = 16 = 4^2."
              },
              {
                "concept_or_rule": "Symmetrical Up-and-Down Sums",
                "step_by_step_procedure": [
                  "Identify the central peak integer n in series 1 + 2 + ... + n + ... + 2 + 1.",
                  "Compute total sum directly by squaring the peak number."
                ],
                "formulas_and_identities": [
                  "1 + 2 + ... + n + ... + 2 + 1 = n^2"
                ],
                "example_problem": "Evaluate 1 + 2 + 3 + 4 + 3 + 2 + 1. Answer: 4^2 = 16."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 2,
      "chapter_title": "Lines and Angles",
      "mind_map": {
        "root_topic": "Lines and Angles",
        "branches": [
          {
            "theme": "2.1 Basic Geometric Primitives",
            "sub_branches": [
              {
                "concept_or_rule": "Points, Segments, Rays, and Lines",
                "step_by_step_procedure": [
                  "Point: Zero-dimensional location.",
                  "Line Segment: Straight path connecting two endpoints.",
                  "Ray: Starts at endpoint and extends infinitely in one direction.",
                  "Line: Extends infinitely in two opposite directions."
                ],
                "formulas_and_identities": [
                  "Unique line property: Exactly 1 line passes through 2 distinct points."
                ],
                "example_problem": "How many lines pass through 1 point? Answer: Infinitely many."
              }
            ]
          },
          {
            "theme": "2.2 - 2.4 Angles, Turns, and Classifications",
            "sub_branches": [
              {
                "concept_or_rule": "Rotational Turns and Degree Measure",
                "step_by_step_procedure": [
                  "1 complete turn = 360\u00b0.",
                  "1/2 turn = Straight angle = 180\u00b0.",
                  "1/4 turn = Right angle = 90\u00b0.",
                  "Multiply fractional turn by 360\u00b0 to find degree measure."
                ],
                "formulas_and_identities": [
                  "Degree Angle = Fraction of Turn x 360\u00b0"
                ],
                "example_problem": "Angle for 5/12 turn: (5/12) x 360\u00b0 = 150\u00b0."
              },
              {
                "concept_or_rule": "Angle Classification",
                "step_by_step_procedure": [
                  "Compare angle measure theta against 90\u00b0, 180\u00b0, and 360\u00b0."
                ],
                "formulas_and_identities": [
                  "Acute: 0\u00b0 < theta < 90\u00b0",
                  "Right: theta = 90\u00b0",
                  "Obtuse: 90\u00b0 < theta < 180\u00b0",
                  "Straight: theta = 180\u00b0",
                  "Reflex: 180\u00b0 < theta < 360\u00b0"
                ],
                "example_problem": "Classify 135\u00b0. Answer: Obtuse Angle."
              }
            ]
          },
          {
            "theme": "2.5 Paper Folding & Perpendiculars",
            "sub_branches": [
              {
                "concept_or_rule": "Perpendiculars and Angle Bisectors",
                "step_by_step_procedure": [
                  "Fold straight line crease onto itself to form perpendicular meeting at four 90\u00b0 right angles.",
                  "Fold angle arms onto each other to form angle bisector (halving the angle)."
                ],
                "formulas_and_identities": [
                  "Bisected Angle = Original Angle / 2"
                ],
                "example_problem": "Bisect a 90\u00b0 angle. Answer: Two 45\u00b0 angles."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 3,
      "chapter_title": "Number Play",
      "mind_map": {
        "root_topic": "Number Play",
        "branches": [
          {
            "theme": "3.1 Place Value and Digit Counting",
            "sub_branches": [
              {
                "concept_or_rule": "Digit Frequency & Ranges",
                "step_by_step_procedure": [
                  "Count occurrences of specific digits in units, tens, and hundreds places across a numerical range."
                ],
                "formulas_and_identities": [
                  "Total N-digit numbers = 9 x 10^(N-1)"
                ],
                "example_problem": "Count of digit '7' from 1 to 100. Answer: 20 times."
              }
            ]
          },
          {
            "theme": "3.2 Palindromes & Algorithms",
            "sub_branches": [
              {
                "concept_or_rule": "Reverse-and-Add Palindrome Algorithm",
                "step_by_step_procedure": [
                  "Step 1: Take positive integer.",
                  "Step 2: Reverse its digits.",
                  "Step 3: Add original and reversed integers.",
                  "Step 4: Repeat on sum until palindromic number is obtained."
                ],
                "formulas_and_identities": [
                  "Palindromic Number: Number equal to its reverse"
                ],
                "example_problem": "Apply to 48: 48 + 84 = 132; 132 + 231 = 363 (Palindrome)."
              },
              {
                "concept_or_rule": "Collatz Conjecture Sequence",
                "step_by_step_procedure": [
                  "If current term n is even -> n / 2.",
                  "If current term n is odd -> 3n + 1.",
                  "Repeat until sequence reaches 1."
                ],
                "formulas_and_identities": [
                  "f(n) = n/2 (even) or 3n+1 (odd)"
                ],
                "example_problem": "Start at 5: 5 -> 16 -> 8 -> 4 -> 2 -> 1."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 4,
      "chapter_title": "Data Handling and Presentation",
      "mind_map": {
        "root_topic": "Data Handling and Presentation",
        "branches": [
          {
            "theme": "4.1 Tally Marks & Frequency Distribution",
            "sub_branches": [
              {
                "concept_or_rule": "Data Organization using Tallies",
                "step_by_step_procedure": [
                  "Record observations using vertical tallies '|'.",
                  "Group every 5th tally with a diagonal slash ('||||/').",
                  "Sum tallies to determine category frequency."
                ],
                "formulas_and_identities": [
                  "Frequency = Count of observations in a category"
                ],
                "example_problem": "Convert '||||/ ||||/ |||' to frequency. Answer: 13."
              }
            ]
          },
          {
            "theme": "4.2 Pictographs and Bar Graphs",
            "sub_branches": [
              {
                "concept_or_rule": "Bar Graph Construction & Scale Rules",
                "step_by_step_procedure": [
                  "Set category axis (horizontal) and frequency scale axis (vertical starting at 0).",
                  "Draw bars of uniform width separated by equal gap distances.",
                  "Calculate bar height = Frequency / Scale Value."
                ],
                "formulas_and_identities": [
                  "Bar Height (cm) = Frequency / Scale per cm"
                ],
                "example_problem": "Frequency = 400, Scale: 1 cm = 100 units. Answer: Height = 4 cm."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 5,
      "chapter_title": "Prime Time",
      "mind_map": {
        "root_topic": "Prime Time",
        "branches": [
          {
            "theme": "5.1 & 5.2 Factors, Multiples, Prime & Composite",
            "sub_branches": [
              {
                "concept_or_rule": "Prime vs Composite & Co-primes",
                "step_by_step_procedure": [
                  "Prime: Exactly 2 factors (1 and itself).",
                  "Composite: More than 2 factors.",
                  "Co-prime: HCF(a, b) = 1."
                ],
                "formulas_and_identities": [
                  "1 is neither prime nor composite"
                ],
                "example_problem": "Are 8 and 9 co-prime? Answer: Yes, HCF(8, 9) = 1."
              }
            ]
          },
          {
            "theme": "5.3 Divisibility Rules & Prime Factorisation",
            "sub_branches": [
              {
                "concept_or_rule": "Divisibility Tests & HCF/LCM Relation",
                "step_by_step_procedure": [
                  "Divisibility by 3/9: Sum of digits divisible by 3/9.",
                  "Divisibility by 4/8: Last 2/3 digits divisible by 4/8.",
                  "Prime factorise numbers to find HCF (lowest prime powers) and LCM (highest prime powers)."
                ],
                "formulas_and_identities": [
                  "HCF(a, b) x LCM(a, b) = a x b"
                ],
                "example_problem": "HCF(12, 18)=6, LCM(12, 18)=36. Check product: 6 x 36 = 216 = 12 x 18."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 6,
      "chapter_title": "Perimeter and Area",
      "mind_map": {
        "root_topic": "Perimeter and Area",
        "branches": [
          {
            "theme": "6.1 Perimeter of Polygons",
            "sub_branches": [
              {
                "concept_or_rule": "Boundary Length Measurement",
                "step_by_step_procedure": [
                  "Sum lengths of all outer boundary sides."
                ],
                "formulas_and_identities": [
                  "Rectangle: P = 2(l + w)",
                  "Square: P = 4s",
                  "Regular n-gon: P = n x s"
                ],
                "example_problem": "Regular hexagon side 7 cm. Answer: P = 6 x 7 = 42 cm."
              }
            ]
          },
          {
            "theme": "6.2 Area & Conservation",
            "sub_branches": [
              {
                "concept_or_rule": "Enclosed Surface Region & Shape Rearrangement",
                "step_by_step_procedure": [
                  "Calculate surface enclosed in square units (sq cm, sq m).",
                  "Cutting and re-arranging conserves total area, but changes perimeter."
                ],
                "formulas_and_identities": [
                  "Rectangle Area: A = l x w",
                  "Square Area: A = s^2"
                ],
                "example_problem": "Plot 25 m x 12 m. Answer: Area = 300 sq m, Perimeter = 74 m."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 7,
      "chapter_title": "Fractions",
      "mind_map": {
        "root_topic": "Fractions",
        "branches": [
          {
            "theme": "7.1 & 7.2 Unit Fractions & Brahmagupta's Operations",
            "sub_branches": [
              {
                "concept_or_rule": "Fractional Units & Operations",
                "step_by_step_procedure": [
                  "Unit fraction 1/n decreases as denominator n increases.",
                  "Convert to common denominator before adding/subtracting numerators."
                ],
                "formulas_and_identities": [
                  "Brahmagupta Addition: a/b + c/d = (ad + bc) / (bd)",
                  "Brahmagupta Subtraction: a/b - c/d = (ad - bc) / (bd)"
                ],
                "example_problem": "Add 2/5 + 1/3. Answer: (2x3 + 5x1) / 15 = 11/15."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 8,
      "chapter_title": "Playing with Constructions",
      "mind_map": {
        "root_topic": "Playing with Constructions",
        "branches": [
          {
            "theme": "8.1 & 8.2 Circle & Polygon Constructions",
            "sub_branches": [
              {
                "concept_or_rule": "Ruler, Compass & Set-Square Rules",
                "step_by_step_procedure": [
                  "Fix center point and open compass to radius r to draw circle.",
                  "Use set-square for exact 90\u00b0 right angle corner construction."
                ],
                "formulas_and_identities": [
                  "d = 2 x r",
                  "Boundary Equidistance: Distance(Center, Boundary) = r"
                ],
                "example_problem": "Radius = 4.5 cm. Answer: Diameter = 9.0 cm."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 9,
      "chapter_title": "Symmetry",
      "mind_map": {
        "root_topic": "Symmetry",
        "branches": [
          {
            "theme": "9.1 & 9.2 Reflectional & Rotational Symmetry",
            "sub_branches": [
              {
                "concept_or_rule": "Symmetry Order & Rotational Angles",
                "step_by_step_procedure": [
                  "Fold test: Line of symmetry causes two mirror halves to overlap.",
                  "Rotation test: Count matching orientations in 360\u00b0 turn (Order n)."
                ],
                "formulas_and_identities": [
                  "Smallest Rotational Angle = 360\u00b0 / Order n",
                  "Regular n-gon: n lines of symmetry, Order n"
                ],
                "example_problem": "Square (n=4): 4 lines of symmetry, Smallest rotational angle = 90\u00b0."
              }
            ]
          }
        ]
      }
    },
    {
      "chapter_number": 10,
      "chapter_title": "The Other Side of Zero",
      "mind_map": {
        "root_topic": "The Other Side of Zero",
        "branches": [
          {
            "theme": "10.1 & 10.2 Integers & Operations",
            "sub_branches": [
              {
                "concept_or_rule": "Integers, Number Line & Brahmagupta Laws",
                "step_by_step_procedure": [
                  "Values decrease moving left on number line.",
                  "Subtracting negative integer is equivalent to adding its positive opposite."
                ],
                "formulas_and_identities": [
                  "a - (-b) = a + b",
                  "Additive Inverse: a + (-a) = 0",
                  "Brahmagupta Zero Law: 0 - A = -A"
                ],
                "example_problem": "Evaluate (-8) - (-13). Answer: -8 + 13 = +5."
              }
            ]
          }
        ]
      }
    }
  ]
}