# ============================================================
# GURUKUL-AI Git Ignore
# ============================================================

# Environment / secrets
.env
.env.*
!.env.example

# Credentials / private keys
credentials.json
secrets.json
serviceAccount.json
service-account.json
*serviceAccount*.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx

# Firebase / Google credentials
firebase-adminsdk*.json
google-credentials*.json
google-service-account*.json

# Node
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/

# Build output
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Python test/cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Archives
*.zip
*.7z
*.rar

# Local databases
*.sqlite
*.sqlite3
*.db

# Secrets
*.secret
*.secrets

# Firebase generated cache
.firebase/

# Generated artifacts
.artifacts/
