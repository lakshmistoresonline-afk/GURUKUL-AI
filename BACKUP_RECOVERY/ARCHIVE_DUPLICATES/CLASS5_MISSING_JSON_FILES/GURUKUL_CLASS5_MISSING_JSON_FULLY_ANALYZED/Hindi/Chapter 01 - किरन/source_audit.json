    "signals": [
      "1 किरन",
      "अरी किरन तू उठकर इतनी",
      "जल्दी आज चली आई।",
      "मैं तो बिस्तर में से अपने",
      "अब तक निकल नहीं पाई।",
      "कल तो तेरे साथ शाम तक",
      "खेल बहुत से खेली मैं।",
      "पर जब तू चल दी सोने को",
      "तो रह गई अके ली मैं।",
      "तू सखु से सोई होगी पर",
      "मझु को नींद नहीं आई।",
      "परी कथाएँ पढ़ते-पढ़ते"
    ]
  },
