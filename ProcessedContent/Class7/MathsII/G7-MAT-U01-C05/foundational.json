    {
      "category": "concepts",
      "item": {
        "concept_name": "Arithmetic Mean as Fair Share",
        "description": "Re-distributing the total sum equally among all entities to determine a single representative central value.",
        "source_context": "Chapter 5: Connecting the Dots..."
      }
    },
    {
      "category": "properties",
      "item": {
        "property_name": "Outlier Resistance of Median",
        "statement": "Extreme outliers significantly pull the arithmetic mean but do not alter the median value.",
        "source_context": "Chapter 5: Connecting the Dots..."
      }
    },
    {
      "category": "rules",
      "item": {
        "rule_name": "Median Position Rules",
        "rule_text": "If total count N is odd: Median is value at position (N+1)/2. If N is even: Median is average of values at positions N/2 and (N/2)+1.",
        "source_context": "Chapter 5: Connecting the Dots..."
      }
    },
    {
      "category": "formulas",
      "item": {
        "formula_name": "Arithmetic Mean",
        "formula_expression": "Mean = (Sum of all observations) / (Total number of observations) = (∑ x_i) / N",
        "source_context": "Chapter 5: Connecting the Dots..."
      }
    },
    {
      "category": "symbols_notation",
      "item": {
        "symbol": "∑",
        "meaning": "Summation of values",
        "source_context": "Chapter 5: Connecting the Dots..."
      }
    }
  ]
