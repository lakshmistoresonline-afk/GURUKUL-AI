    },
    {
      "category": "word_usage",
      "item": {
        "word": "भूजल गुल्लक",
        "usage_in_context": "वर्षा का पानी छनकर धरती की गुल्लक में जमा होता है।",
        "meaning_in_context": "ज़मीन के नीचे के जल भंडार का बचत खाते रूपी प्रयोग।",
        "chapter_reference": "अध्याय 4"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "word": "लंघनम् सर्वोत्तमम् औषधम्",
        "usage_in_context": "बीमारी में नानाजी ने कहा— लंघनम् सर्वोत्तमम् औषधम्।",
        "meaning_in_context": "उपवास द्वारा शरीर के दोषों का निवारण करना।",
        "chapter_reference": "अध्याय 5"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "word": "जग में हँसाई",
        "usage_in_context": "बिना विचारे जो करै... जग में होत हँसाई।",
        "meaning_in_context": "अविवेकपूर्ण कदम उठाने पर समाज में अपमानित होना।",
        "chapter_reference": "अध्याय 6"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "word": "गंडा बाँधना",
        "usage_in_context": "पिताजी ने दो हज़ार रुपये नजराना लेकर मेरा गंडा बाँधा।",
        "meaning_in_context": "शास्त्रीय कला में औपचारिक रूप से शिष्यता स्वीकारना।",
        "chapter_reference": "अध्याय 8"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "word": "सोने की कड़ियाँ",
        "usage_in_context": "मानव अपनी सोने की कड़ियाँ तोड़ डाले।",
        "meaning_in_context": "धन-दौलत और भौतिक साधनों के मोह-जाल से मुक्त होना।",
        "chapter_reference": "अध्याय 9"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "word": "नैनों में बसना",
        "usage_in_context": "बसो मेरे नैनन में नंदलाल।",
        "meaning_in_context": "ईश्वर के सुंदर रूप का मन-मस्तिष्क में अनवरत ध्यान रहना।",
        "chapter_reference": "अध्याय 10"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "संवादात्मक शैली (Dialogue Structure)",
        "description": "दो पात्रों (माँ और पुत्र) के बीच सहज प्रश्नोत्तर रूप में कथा का आगे बढ़ना।",
        "example": "माँ, कह एक कहानी। / बेटा, तू है हठी मानधन मेरे, क्या तूने मुझको अपनी नानी माना?",
        "chapter_reference": "अध्याय 1: माँ, कह एक कहानी"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "तार्किक-अन्वेषणात्मक वाक्य संरचना (Deductive Logic Structure)",
        "description": "साक्ष्य (Observation) -> तर्क (Reasoning) -> निष्कर्ष (Deduction) के क्रम में गठित वाक्य।",
        "example": "रास्ते की केवल एक ओर की पत्तियाँ खाई गई हैं, अतः ऊँट एक आँख से काना है।",
        "chapter_reference": "अध्याय 2: चतुर बालक"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "प्रतीकात्मक तुलनात्मक संरचना (Metaphorical Contrast Structure)",
        "description": "दो विरोधी प्राकृतिक वस्तुओं की समानांतर तुलना द्वारा नैतिक नियम स्थापित करना।",
        "example": "छेद कर काँटा किसी की उँगलियाँ... फूल तितलियों को गोद में खिलाता।",
        "chapter_reference": "अध्याय 3: फूल और काँटा"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "निबंधात्मक एवं रूपकात्मक संरचना (Explanatory Essay Structure)",
        "description": "पर्यावरण और विज्ञान के सिद्धांतों को जीवन-अनुभवों से जोड़कर निबंध रूप में प्रस्तुत करना।",
        "example": "जैसे हम गुल्लक में सिक्के जमा करते हैं, वैसे ही वर्षा का पानी धरती की गुल्लक में जमा होता है।",
        "chapter_reference": "अध्याय 4: पानी ले पानी"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "स्वगत कथन / आत्मकथ्य संरचना (Monologue Structure)",
        "description": "पात्र द्वारा स्वयं से मन ही मन बातचीत करना और मानसिक कल्पना को प्रकट करना।",
        "example": "रजाई ओढ़कर लेटा रहूँगा, गर्म साबूदाने की खीर मिलेगी और स्कूल भी नहीं जाना पड़ेगा।",
        "chapter_reference": "अध्याय 5: नहीं होना बीमार"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "कुंडलिया छंद संरचना (Kundaliya Poetic Meter)",
        "description": "छह पंक्तियों का विषम मात्रिक छंद जिसका पहला और अंतिम शब्द एक ही होता है।",
        "example": "बिना विचारे जो करै सो पाछे पछिताय... काम बिगारै आपनो जग में होत हँसाई... 'बिना' / 'बिचारे'।",
        "chapter_reference": "अध्याय 6: गिरधर कविराय की कुंडलियाँ"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "साक्षात्कार विधा संरचना (Interview Format Structure)",
        "description": "प्रश्नकर्ता द्वारा प्रश्न पूछने और उत्तरदाता द्वारा आत्मकथात्मक उत्तर देने की संरचना।",
        "example": "प्रश्न: आपने कथक कहाँ से सीखा? / उत्तर: पिताजी और चाचाजी के सानिध्य में लखनऊ घराने में।",
        "chapter_reference": "अध्याय 8: बिरजू महाराज से साक्षात्कार"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "structure_type": "गेय पद रचना (Devotional Song Structure)",
        "description": "ब्रजभाषा की भावपूर्ण संगीतात्मक पंक्तियाँ जो ताल और राग में गाई जाती हैं।",
        "example": "बसो मेरे नैनन में नंदलाल। मोहिनी मूरति साँवरी सूरति, नैना बने बिसाल।",
        "chapter_reference": "अध्याय 10: मीरा के पद"
      }
    },
