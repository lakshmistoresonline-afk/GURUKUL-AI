    {
      "category": "literary_devices",
      "item": {
        "device_name": "अनुप्रास अलंकार (Alliteration)",
        "definition": "जहाँ काव्य में समान वर्णों की बार-बार आवृत्ति से सौंदर्य उत्पन्न हो।",
        "example": "'वर्ण-वर्ण के फूल खिले थे' (व वर्ण की आवृत्ति), 'साँवरी सूरति' (स वर्ण की आवृत्ति), 'मोहिनी मूरति' (म वर्ण की आवृत्ति)।",
        "chapter_reference": "अध्याय 1, 10"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "मानवीकरण अलंकार (Personification)",
        "definition": "जहाँ प्रकृति की अचेतन वस्तुओं (पेड़, पौधे, फूल, वर्षा) पर मानवीय भावनाओं व क्रियाओं का आरोप हो।",
        "example": "'फूल तितलियों को गोद में खिलाता है', 'वर्षा-बहार में किसान मनहर गीत गाते हैं'।",
        "chapter_reference": "अध्याय 3, 7"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "रूपक अलंकार (Metaphor)",
        "definition": "जहाँ उपमेय और उपमान में भेद मिटाकर एकरूपता दर्शाई जाए।",
        "example": "'धरती की गुल्लक' (भूजल की तुलना बचत गुल्लक से), 'सोने की कड़ियाँ' (भौतिक सुखों का बंधन)।",
        "chapter_reference": "अध्याय 4, 9"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "पुनरुक्ति प्रकाश अलंकार (Repetition for Emphasis)",
        "definition": "जहाँ कथन में प्रभाव और सौंदर्य बढ़ाने के लिए एक ही शब्द दो बार आए।",
        "example": "'रिम-झिम रिम-झिम वर्षा की बूँदें', 'चम-चम चमकती बिजली'।",
        "chapter_reference": "अध्याय 7"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "कुंडलिया छंद (Kundaliya Meter)",
        "definition": "मध्यकालीन नीति काव्य का छह चरणों वाला विषम मात्रिक छंद जिसमें दोहा और रोला का मिश्रण होता है तथा पहला व अंतिम शब्द समान रहता है।",
        "example": "'बिना' विचारे जो करै सो पाछे पछिताय... जग में होत हँसाई... 'बिना' / 'बिचारे'।",
        "chapter_reference": "अध्याय 6"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "संवादात्मक शैली (Conversational/Dialogue Style)",
        "definition": "पात्रों के बीच सीधे संवादों द्वारा कहानी या कविता का विकास करना।",
        "example": "माँ और बालक राहुल के बीच संवाद: 'माँ, कह एक कहानी... बेटा, तू है हठी मानधन मेरे'।",
        "chapter_reference": "अध्याय 1"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device_name": "प्रतीकात्मकता (Symbolism)",
        "definition": "प्राकृतिक या व्यावहारिक वस्तुओं को मानवीय गुणों/अवगुणों के प्रतीक के रूप में प्रस्तुत करना।",
        "example": "फूल = सज्जन/परोपकारी व्यक्ति; काँटा = दुर्जन/पीड़ादायक व्यक्ति; चिड़िया = स्वतंत्रता व असंग्रह का प्रतीक।",
        "chapter_reference": "अध्याय 3, 9"
      }
