          "अनोखा (विशेषण) ढंग (विशेष्य)"
        ],
        "chapter_reference": "अध्याय 1, 3, 7"
      }
    },
    {
      "category": "grammar",
      "item": {
        "topic": "उपसर्ग (Prefixes)",
        "rule_description": "मूल शब्द के पूर्व में जुड़कर नए अर्थ का निर्माण करने वाले शब्दांश उपसर्ग कहलाते हैं।",
        "examples": [
          "अ + दृश्य = अदृश्य",
          "सु + शिक्षित = सुशिक्षित",
          "निर् + दयी = निर्दयी",
          "निर् + अपराध = निरपराध",
          "अ + चूक = अचूक",
          "स्व + छंद = स्वच्छंद",
          "अ + संग्रह = असंग्रह"
        ],
        "chapter_reference": "अध्याय 2, 5, 9"
      }
    },
    {
