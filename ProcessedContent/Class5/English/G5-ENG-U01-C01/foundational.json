      "category": "spelling",
      "item": {
        "item": "Silent 'k' rule",
        "word": "know",
        "silent_letter": "k",
        "rule": "The letter 'k' before 'n' at the beginning of a word is silent (/neʊ/).",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "spelling",
      "item": {
        "item": "Silent 'w' rule",
        "word": "write",
        "silent_letter": "w",
        "rule": "The letter 'w' before 'r' at the start of a word is silent (/raɪt/).",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "spelling",
      "item": {
        "item": "Silent 'g' in '-ign'",
        "word": "design",
        "silent_letter": "g",
        "rule": "The letter 'g' in the '-ign' root ending is silent (/dɪˈzaɪn/).",
        "source_context": "Chapter 10: Glass Bangles"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "phrase_or_word": "a pair of",
        "usage_example": "Papa lost his spectacles, which was his only pair.",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "word_usage",
      "item": {
        "phrase_or_word": "illuminated workshop",
