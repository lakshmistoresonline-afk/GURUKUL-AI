        "source_context": "Chapter 10: Glass Bangles"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Interrogative Questions",
        "structure_rule": "Question word + Auxiliary verb + Subject + Main verb?",
        "example": "Where can my spectacles be?",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Exclamatory Statements",
        "structure_rule": "Exclamation mark (!) showing sudden emotion or surprise.",
        "example": "Papa, your spectacles are right there on your head!",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Past Perfect Time Sequence",
        "structure_rule": "Subject + had + V3 + before + Past Clause.",
        "example": "Ananya had completed her studies before she returned to help her family.",
        "source_context": "Chapter 10: Glass Bangles"
      }
    },
