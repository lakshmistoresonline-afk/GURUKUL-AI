{
  "textbook_metadata": {
    "textbook": "Santoor (NCERT Class 5 English)",
    "publisher": "NCERT (National Council of Educational Research and Training)",
    "grade": "Class 5",
    "curriculum_framework": "NCF-SE 2023 / NEP 2020"
  },
  "subject_type": "LANGUAGE",
  "modules": [
    {
      "category": "grammar",
      "item": {
        "concept": "Contractions",
        "explanation": "Shortened forms of words using an apostrophe to replace missing letters.",
        "examples": [
          "can't (cannot)",
          "where's (where is)",
          "he's (he is)",
          "shouldn't (should not)",
          "couldn't (could not)"
        ],
        "source_context": "Chapter 1: Papa's Spectacles & Chapter 6: What a Tank!"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Adverbs of Frequency",
        "explanation": "Words that describe how often an action takes place.",
        "examples": [
          "always",
          "often",
          "sometimes",
          "rarely",
          "never"
        ],
        "source_context": "Chapter 2: Gone with the Scooter"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Prepositions of Movement and Place",
        "explanation": "Words showing position or direction of movement relative to objects.",
        "examples": [
          "under the chair",
          "into the basket",
          "across the gate",
          "through the lane",
          "past the gate"
        ],
        "source_context": "Chapter 2: Gone with the Scooter & Chapter 9: Vocation"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Degrees of Comparison",
        "explanation": "Adjective forms used to compare qualities (Positive, Comparative, Superlative).",
        "examples": [
          "pretty -> prettier -> prettiest",
          "grand -> grander -> grandest"
        ],
        "source_context": "Chapter 3: The Rainbow"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Adverbs of Manner",
        "explanation": "Words that describe how an action is performed, usually ending in '-ly'.",
        "examples": [
          "sorrowfully laid",
          "silently watched",
          "joyfully flew"
        ],
        "source_context": "Chapter 4: The Wise Parrot"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Present Continuous Tense",
        "explanation": "Verb tense expressing ongoing actions happening at the current moment.",
        "examples": [
          "is growing legs",
          "is swimming in the pond"
        ],
        "source_context": "Chapter 5: My Frog's World"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Modal Auxiliaries",
        "explanation": "Helper verbs expressing necessity, obligation, or duty.",
        "examples": [
          "must save water",
          "should turn off taps",
          "ought to help elders"
        ],
        "source_context": "Chapter 6: What a Tank!"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Abstract Nouns",
        "explanation": "Nouns representing intangible ideas, qualities, or feelings that cannot be touched.",
        "examples": [
          "sportsmanship",
          "courage",
          "truth",
          "joy",
          "wisdom"
        ],
        "source_context": "Chapter 7: Gilli Danda"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Possessive Pronouns",
        "explanation": "Pronouns showing ownership or belonging without repeating the noun.",
        "examples": [
          "mine",
          "yours",
          "his",
          "hers",
          "ours",
          "theirs"
        ],
        "source_context": "Chapter 7: Gilli Danda"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Prefixes (un-, dis-, im-)",
        "explanation": "Word parts added before a root word to change its meaning into its opposite.",
        "examples": [
          "un- + kind = unkind",
          "dis- + honest = dishonest",
          "im- + possible = impossible"
        ],
        "source_context": "Chapter 7: Gilli Danda & Chapter 8: The Decision of the Panchayat"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Suffixes (-ful, -less, -ment)",
        "explanation": "Word parts added after a root word to form new adjectives or nouns.",
        "examples": [
          "care + -less = careless",
          "deceit + -ful = deceitful",
          "judge + -ment = judgment"
        ],
        "source_context": "Chapter 8: The Decision of the Panchayat"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Conditional Clauses (If-then Logic)",
        "explanation": "Sentence structures stating a condition and its consequence.",
        "examples": [
          "If you own the water, then pay rent for storing it in my well."
        ],
        "source_context": "Chapter 8: The Decision of the Panchayat"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Subjunctive Expression of Wishes",
        "explanation": "Sentence pattern starting with 'I wish I were...' to express imaginative desires.",
        "examples": [
          "I wish I were a hawker spending my day in the road."
        ],
        "source_context": "Chapter 9: Vocation"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Past Perfect Tense",
        "explanation": "Verb tense used to describe an action completed before another action in the past.",
        "examples": [
          "Ananya had completed her studies before returning to Firozabad."
        ],
        "source_context": "Chapter 10: Glass Bangles"
      }
    },
    {
      "category": "grammar",
      "item": {
        "concept": "Proper Nouns",
        "explanation": "Specific capitalized names of people, places, festivals, or heritage centers.",
        "examples": [
          "Firozabad",
          "Diwali",
          "Ravi",
          "Ananya",
          "Bharatpur"
        ],
        "source_context": "Chapter 4: The Wise Parrot & Chapter 10: Glass Bangles"
      }
    },
