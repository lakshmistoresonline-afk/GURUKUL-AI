    {
      "category": "literary_devices",
      "item": {
        "device": "Simile",
        "definition": "A figure of speech comparing two different things using 'like' or 'as'.",
        "example": "The street-lamp stands like a giant with one red eye in its head.",
        "source_context": "Chapter 9: Vocation"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device": "Personification",
        "definition": "Giving human qualities or actions to non-human objects or natural elements.",
        "example": "The bow that bridges heaven, and builds a road from earth to sky.",
        "source_context": "Chapter 3: The Rainbow"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device": "Onomatopoeia",
        "definition": "Words that imitate the natural sound associated with the object or action.",
        "example": "rustle (dry leaves), pitter-patter (raindrops), thud (ball bounce), whack (striking gilli).",
        "source_context": "Chapter 2: Gone with the Scooter & Chapter 7: Gilli Danda"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device": "Metaphor",
        "definition": "A direct comparison between two unrelated things without using 'like' or 'as'.",
        "example": "The 'golden cage' representing physical luxury without freedom.",
        "source_context": "Chapter 4: The Wise Parrot"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device": "Rhyming Scheme & Pairs",
        "definition": "Words at the end of poetic lines that share identical vowel and consonant sounds.",
        "example": "seas / these, please / trees; head / said; pair / everywhere.",
        "source_context": "Chapter 1: Papa's Spectacles & Chapter 3: The Rainbow"
      }
    },
    {
      "category": "literary_devices",
      "item": {
        "device": "Alliteration",
        "definition": "The repetition of identical initial consonant sounds in successive words.",
        "example": "pitter-patter, boat bridges, webbed water.",
        "source_context": "Chapter 3: The Rainbow & Chapter 5: My Frog's World"
      }
    }
  ]
