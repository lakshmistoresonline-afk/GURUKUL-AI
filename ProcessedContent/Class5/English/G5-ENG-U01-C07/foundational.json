    {
      "category": "sentence_structure",
      "item": {
        "type": "Interrogative Questions",
        "structure_rule": "Question word + Auxiliary verb + Subject + Main verb?",
        "example": "Where can my spectacles be?",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Exclamatory Statements",
        "structure_rule": "Exclamation mark (!) showing sudden emotion or surprise.",
        "example": "Papa, your spectacles are right there on your head!",
        "source_context": "Chapter 1: Papa's Spectacles"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Comparative Sentences",
        "structure_rule": "Subject + Verb + Comparative Adjective + 'than' + Object.",
        "example": "Clouds that sail across the sky are prettier than boats on rivers.",
        "source_context": "Chapter 3: The Rainbow"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Imperative Slogans",
        "structure_rule": "Base verb command form used for public environmental awareness.",
        "example": "Turn off running taps and save every drop of water!",
        "source_context": "Chapter 6: What a Tank!"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Possessive Statements",
        "structure_rule": "Demonstrative Pronoun + Verb + Possessive Pronoun.",
        "example": "This danda belongs to me; it is mine.",
        "source_context": "Chapter 7: Gilli Danda"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Conditional If-Then Sentence",
        "structure_rule": "If + Present Condition, + Main Clause Consequence.",
        "example": "If you own the water, then pay rent for storing it in my well.",
        "source_context": "Chapter 8: The Decision of the Panchayat"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Subjunctive Wish Structure",
        "structure_rule": "I wish + Subject + were + Noun/Profession.",
        "example": "I wish I were a gardener digging away at the garden.",
        "source_context": "Chapter 9: Vocation"
      }
    },
    {
      "category": "sentence_structure",
      "item": {
        "type": "Past Perfect Time Sequence",
        "structure_rule": "Subject + had + V3 + before + Past Clause.",
        "example": "Ananya had completed her studies before she returned to help her family.",
        "source_context": "Chapter 10: Glass Bangles"
      }
    },
